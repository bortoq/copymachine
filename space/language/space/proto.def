/*
 * CHANNEL PROTOCOL -- single source of truth (X-macro).
 *
 * Consumed at build time by tools/proto_gen.py; never included in C.
 * By this file both the emulator side (encode/decode/tables) and the
 * in-space driver (request/answer copycode) are generated, so they
 * cannot drift apart.
 *
 * Field widths: a decimal number is a literal bit count; ADDR and NF are
 * symbolic and resolved from the space size at run time
 * (ADDR = address bits; NF is an unused legacy generator token).
 *
 * Order matters: fields are laid out low bit first in the listed order.
 * XOP(name, value)         operation codes (0 = NONE/empty)
 * XFIELD(req|rsp, name, w) request/response record field
 * XDEV(id, name, mode)     device pre-bound at startup (channel position
 *                          space_nbits+1+table_index, in table order;
 *                          id names the inherited descriptor)
 *
 * The records are the SYS protocol only. A data channel carries data:
 * a copy to it writes data out, a copy from it reads data in. Data never
 * carries a record; state is read through SYS.
 */

XOP(NONE,  0)
XOP(CLOSE, 1)
XOP(SEEK,  2)
XOP(FSTAT, 3)
XOP(IOCTL, 4)
XOP(EXEC,  5)
/*
 * LONG (15.2, the definition of the word "space"): the long copy, a copy to
 * or from a remote space (isolated, with its own addressing). The request
 * record is the same: chan = the number of the remote space, flags bit 0 =
 * the direction (0: to the remote space, 1: from it), arg = the length in
 * bits, off = the position (bits) in the remote space. To: the data is the
 * arg bits written to SYS right after the record (as the command of EXEC).
 * From: the data is the answer, the next answer reads of SYS get these bits
 * (taken at the tick of the request) instead of the answer record. Remote
 * space 0 is the old SYS: the request record (and EXEC command) written to
 * its position 0 is the old request, a read gives the bits of the old
 * answer record. Space 1 is the clock: a read gives the 64-bit monotonic
 * time of the host in nanoseconds (numeric, least significant bit first).
 * Spaces 2.. are the host files given at startup (-r path, in order), bit
 * addressed (position 0 is the high bit of byte 0); a read past the end
 * gives zeros, a write past the end extends the file.
 */
XOP(LONG,  6)
/* reserve: SPAWN, POLL, MMAP, ... */

XFIELD(req, op,    8)
XFIELD(req, chan,  ADDR)
XFIELD(req, flags, 16)
XFIELD(req, arg,   32)
XFIELD(req, off,   64)

XFIELD(rsp, op,     8)
XFIELD(rsp, status, 8)
XFIELD(rsp, flags,  16)
XFIELD(rsp, size,   64)
XFIELD(rsp, moved,  ADDR)
XFIELD(rsp, eof,    1)

XDEV(0, stdin,  "r")
XDEV(1, stdout, "w")

/* Separate diagnostic output, inherited as descriptor 2 (stderr). */
XDEV(2, debug, "w")
/* Optional pre-opened streams. Positions remain reserved when absent. */
XDEV(3, status, "w")
XDEV(4, snapshot, "w")
