if &q1 &ws6 &ws7
:ws6 block
call &act &ws6b
:ws6b block
copy &inw &zero
ret
:ws7 block
copy &inw &one1
ret

# --- an argument (a number, a string or a reference) of the word in hand: the kind comes from the table shape (wd, na)
:argproc word
