copy &fo &zero
goto &floop
:floop block
eq &fj &nsym &fq
if &fq[2] &fnone &fcmp
:fnone block
ret
:fcmp block
lut &stg &fj[0:10] &et
eq &nm[96:112] &et &ft
if &ft[3] &fc1 &fnext
:fc1 block
lut &sna &fj[0:10] &ea
eq &nm[0:56] &ea &fm
if &fm[13] &fc2 &fnext
:fc2 block
lut &snb &fj[0:10] &eb
eq &nm[56:112] &eb &fn
if &fn[13] &ffound &fnext
:fnext block
add &fj &one12 &fr
copy &fj &fr[0:12]
goto &floop
:ffound block
copy &fo &one1
lut &ski &fj[0:10] &fkind
lut &sad &fj[0:10] &faddr
lut &sin &fj[0:10] &finfo
ret

# --- the word in nm: kwf = it is a word, kwc = its code (the table kw holds the words as 5 bytes, the last byte is the last letter)
:kwfind word
copy &kwf &zero
lut &gt5 &nlen[0:4] &q1
if &q1 &kwend &kw0
:kw0 block
copy &ki &zero8
goto &kwl
:kwl block
lut &kw &ki[0:5] &kwv
eq &nm[72:112] &kwv &kwq
if &kwq[9] &kwhit &kwnx
:kwhit block
copy &kwf &one1
copy &kwc &ki
ret
:kwnx block
lut &inc8 &ki &ki
eq &ki &cnw &q2
if &q2[1] &kwend &kwl
:kwend block
ret

# --- the end of a token
:tokend word
