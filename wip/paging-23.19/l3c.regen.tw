if &q1 &tkpack &tkf9
:tkpack block
copy &packm &one1
call &prel &tdone
:tkf9 block
call &prel &tkn0
:tkn0 block
if &tf[0] &tkl &te1
:tkl block
if &inw &bad &tkl0
:tkl0 block
if &nz &tkl2 &bad
:tkl2 block
if &pend &bad &tkl3
:tkl3 block
copy &pend &one1
copy &lbl &nm
goto &tdone
:te1 block
