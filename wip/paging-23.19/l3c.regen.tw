:xq2 block
if &q5[4] &fixe &fixb
:fixb block
copy &h &z20
if &bidx[2] &fv4 &fv0
:fv0 block
if &bidx[1] &fv2 &fv01
:fv01 block
if &bidx[0] &fvsub &fvadd
:fvadd block
