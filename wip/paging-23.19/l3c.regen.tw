copy &dsl[8:20] &z20[0:12]
shl &dsl &ds8 3
copy &wxa &ds8
copy &wxb &tout20
call &weq &xq19
:xq19 block
if &q5[4] &tes2 &bad
:tes2 block
call &ebytes &tes3
:tes3 block
copy &wxa &tstr20
