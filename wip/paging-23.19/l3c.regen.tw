# --- the arithmetic of 20 bits as words (a copy of the arguments and a call cost less than a chain of five tables for each use)
:wadd word
add &wxa &wxb &wxr
ret
:wsub word
sub &wxa &wxb &wxr
ret
:wlt word
lt &wxa &wxb &ltc
ret
:weq word
eq &wxa &wxb &q5
ret
