if &q1 &bad &tkw5
:tkw5 block
call &wstart &tdone
:te2 block
if &tf[4] &te3 &te5
:te3 block
if &nz &te4 &bad
:te4 block
if &rf[4] &te4b &te5
:te4b block
if &rf[2] &te5 &bad
:te5 block
call &argproc &tdone
:tdone block
copy &tf &z6
copy &rf &z6[0:5]
copy &sclose &zero
ret

# --- a word begins (code in kwc): a label iff it defines; at most 1024 symbols; a block open or not
:wstart word
copy &wd &kwc
copy &na &zero8
copy &ai &zero8
copy &nb &zero8
