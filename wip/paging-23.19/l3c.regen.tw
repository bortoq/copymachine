copy &wxb &span
call &wadd &xq4
:xq4 block
copy &s21 &wxr
copy &pos &s21[0:20]
goto &fint
:fin9 block
copy &ale &c3e
call &align &fin10
:fin10 block
emit &s_cole
emit &zero8
halt

# --- the errors: the report to stderr and the halt (the output so far stays as it is; the first lines go out first)
:bad block
call &prel &bad2
:bad2 block
warn &msg_bad
halt
:lab block
call &prel &lab2
:lab2 block
warn &msg_lab
halt
:wid block
call &prel &wid2
:wid2 block
warn &msg_wid
halt
:blk block
call &prel &blk2
:blk2 block
warn &msg_blk
halt
:big block
call &prel &big2
:big2 block
warn &msg_big
halt

# --- the first lines of the text, once: when the first token has ended (or the text, or an error, came first). The pack mode (the first
# token is `pack`) has a boot layer and a first layer of three slots: the data begin 80 bits later, the bits of `zero` and `one` too.
:prel word
if &pdone &prelx &prel1
:prelx block
ret
:prel1 block
copy &pdone &one1
emit &pre1
emit &pre2
if &packm &prelp &prels
:prels block
emit &pre3
emit &pre4
copy &pos &start
ret
:prelp block
emit &pp3
emit &pp4
copy &pos &pstart
copy &zaddr &z240
copy &oaddr &z304
copy &s_plus &s_plusp
store &sad &zi3 &z240
ret

# --- a name starts again; the number of a digit
:clrname word
copy &nlen &zero8
copy &nz &zero
