:tkfirst block
copy &started &one1
if &tf[1] &tkf1 &tkf9
:tkf1 block
if &inw &tkf9 &tkf2
:tkf2 block
call &kwfind &tkf3
:tkf3 block
if &kwf &tkf4 &tkf9
:tkf4 block
