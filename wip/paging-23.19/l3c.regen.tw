:fvand block
copy &a4 &ix[0:4]
copy &b4 &ix[4:8]
band &a4 &b4 &v4
copy &h[0:4] &v4
goto &fvp
:fvlt block
copy &a4 &ix[0:4]
copy &b4 &ix[4:8]
copy &cc2[0] &ix[8]
