call &puthex &dvn5
:dvn5 block
emit &sp
copy &h &num
call &puthex &dvn6
:dvn6 block
emit &nl8
copy &wxa &dn
copy &wxb &dm
call &wsub &xq15
:xq15 block
copy &s21 &wxr
copy &zc &s21[0:20]
call &zrun &dvend
:dvs block
call &ebytes &dvs2
:dvs2 block
copy &wxa &dn
copy &wxb &ds8
call &wsub &xq16
:xq16 block
copy &s21 &wxr
copy &zc &s21[0:20]
call &zrun &dvend
:dvend block
copy &wxa &pos
copy &wxb &dn
call &wadd &xq17
:xq17 block
copy &s21 &wxr
copy &pos &s21[0:20]
copy &fd &one1
copy &fact &zero
