emit &s_d
copy &h[0:5] &fw
copy &h[5:20] &z20[0:15]
call &puthex &fvp2
:fvp2 block
emit &sp
copy &h &hv
call &puthex &fvp3
:fvp3 block
emit &nl8
copy &wxa &ix
copy &wxb &c1
call &wadd &xq3
:xq3 block
copy &s21 &wxr
copy &ix &s21[0:20]
goto &fixl
:fixe block
