copy &dg[0:4] &cl[12:16]
copy &wxa &s21[0:20]
copy &wxb &dg
call &wadd &xq6
:xq6 block
copy &s21b &wxr
copy &num &s21b[0:20]
ret

# --- the symbols: insert the name in nm with ikind, iaddr, iinfo; find the name in nm (fo, fkind, faddr, finfo)
:insert word
store &sna &nsym[0:10] &nm[0:56]
store &snb &nsym[0:10] &nm[56:112]
store &stg &nsym[0:10] &nm[96:112]
store &ski &nsym[0:10] &ikind
store &sad &nsym[0:10] &iaddr
store &sin &nsym[0:10] &iinfo
