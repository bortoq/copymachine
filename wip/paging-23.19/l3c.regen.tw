# --- the output: hex digits of h without leading zeros (h is spoiled), the name in pnm, the zeros, the position
:puthex word
copy &cnt &c5
copy &sn[0] &zero
goto &phl
:phl block
copy &nib &h[16:20]
shl &h &h2 4
shr &cnt &cnt2 1
lut &nzt &nib &sn[1:2]
copy &sn[2] &cnt2[0]
lut &stt &sn &st2
copy &h &h2
copy &cnt &cnt2
if &st2 &phpr &phnp
:phpr block
lut &hex4 &nib &hch
emit &hch
goto &phnp
:phnp block
copy &sn[0] &st2
if &cnt[0] &phl &phend
:phend block
ret

:pname word
copy &pi &zero8
goto &pnl1
:pnl1 block
lut &nzt &pnm[0:4] &pz[0]
lut &nzt &pnm[4:8] &pz[1]
lut &or2 &pz &pnz
if &pnz &pnem &pnx
:pnem block
copy &pby &pnm[0:8]
emit &pby
goto &pnx
:pnx block
copy &pnt[0:104] &pnm[8:112]
copy &pnt[104:112] &zero8
copy &pnm &pnt
lut &inc8 &pi &pi
eq &pi &c14 &q2
if &q2[1] &pnend &pnl1
:pnend block
ret

# an operand of a row: a number (h), or a label: &t and the letter of the builtin (1), &r and the name in rname (2)
:popd word
if &lk[0] &pdb &pd1
:pdb block
emit &s_at
emit &tchar
ret
:pd1 block
if &lk[1] &pdr &pdn
:pdr block
emit &s_ar
copy &pnm &rname
call &pname &pdz
:pdn block
call &puthex &pdz
:pdz block
ret

# the jump to the next layer: c a0 0 <the next layer>; the position moves by a layer
:pjump word
emit &s_jmp
copy &wxa &pos
copy &wxb &c160
call &wadd &xq25
:xq25 block
copy &pr &wxr
copy &pos &pr[0:20]
copy &h &pos
call &puthex &pj2
:pj2 block
emit &nl8
ret

:pgap word
emit &s_gap
call &pjump &pg2
:pg2 block
ret

# the last layer with a jump to a block (jt 1: &b and the name bn0), the end (2: &e) or nothing (3: 0)
:lastx word
emit &s_gap
emit &s_jmp
if &jtv[0] &lx1 &lx2
:lx1 block
if &jtv[1] &lx0 &lxb
:lxb block
emit &s_ab
copy &pnm &bn0
call &pname &lxe
:lx0 block
emit &s_one
goto &lxe
:lx2 block
emit &s_ae
goto &lxe
:lxe block
emit &nl8
copy &wxa &pos
copy &wxb &c160
call &wadd &xq26
:xq26 block
copy &pr &wxr
copy &pos &pr[0:20]
ret

# a layer with a copy row: c p1 p2 p3 (the operands p2 and p3 are labels when lk2 and lk3 say so)
:lc word
emit &s_c
copy &h &p1
call &puthex &lc1
:lc1 block
emit &sp
copy &h &p2
copy &lk &lk2
call &popd &lc2
:lc2 block
emit &sp
copy &h &p3
copy &lk &lk3
call &popd &lc3
:lc3 block
emit &nl8
copy &lk2 &y0
copy &lk3 &y0
call &pjump &lc4
:lc4 block
ret

# a layer with a row of four numbers (qd1 .. qd4): the rows of the channels
:lq word
emit &s_d14
copy &h &qd1
call &puthex &lq1
:lq1 block
emit &nl8
emit &s_d14
copy &h &qd2
call &puthex &lq2
:lq2 block
emit &nl8
emit &s_d14
copy &h &qd3
call &puthex &lq3
:lq3 block
emit &nl8
emit &s_d14
copy &h &qd4
call &puthex &lq4
:lq4 block
emit &nl8
call &pjump &lq5
:lq5 block
ret

# zc zero bits: z ff lines, then the rest
:zrun word
goto &zl
:zl block
copy &wxa &zc
copy &wxb &c255
call &wsub &xq27
:xq27 block
copy &zr &wxr
if &zr[20] &zend &zbody
:zbody block
emit &s_zff
copy &zc &zr[0:20]
goto &zl
:zend block
eq &zc[0:8] &zero8 &q2
if &q2[1] &zfin &zprint
:zprint block
emit &s_z
copy &h &zc
call &puthex &zp2
:zp2 block
emit &nl8
ret
:zfin block
ret

# is the position pos + q inside the limit
:chk word
copy &wxa &pos
copy &wxb &q
call &wadd &xq28
:xq28 block
copy &chs &wxr
if &chs[20] &big &chk2
:chk2 block
copy &wxa &limit
copy &wxb &chs[0:20]
call &wlt &xq29
:xq29 block
if &ltc[5] &big &chk3
:chk3 block
ret

# pad = the zeros which bring pos to a multiple of 2^ale (ale <= 31)
:padcalc word
copy &wxa &z20
copy &wxb &pos
call &wsub &xq30
:xq30 block
copy &neg &wxr
lut &mask &ale &mk
band &neg[0:20] &mk &pad
ret

:doalign word
copy &zc &pad
call &zrun &da2
:da2 block
copy &wxa &pos
copy &wxb &pad
call &wadd &xq31
:xq31 block
copy &s21 &wxr
copy &pos &s21[0:20]
ret

:align word
call &padcalc &aln2
:aln2 block
call &amark &aln5
:aln5 block
call &doalign &aln3
:aln3 block
ret

# pack mode: the line `# a<k> <pad>` before the pad of an alignment to 2^k (the pass l3p counts the pad anew)
:amark word
if &packm &aln4 &aln8
:aln8 block
ret
:aln4 block
emit &s_mark
copy &h[0:5] &ale
copy &h[5:20] &z20[0:15]
call &puthex &aln6
:aln6 block
emit &sp
copy &h &pad
call &puthex &aln7
:aln7 block
emit &nl8
ret

# the bytes of the string in hand: d 8 <byte>
:ebytes word
copy &ix &z20
goto &ebl
:ebl block
copy &lx &ix[0:8]
eq &lx &slen &q2
if &q2[1] &ebend &ebb
:ebb block
lut &sb &lx[0:5] &pby
emit &s_dl8
copy &h[0:8] &pby
copy &h[8:20] &z20[0:12]
call &puthex &eb2
:eb2 block
emit &nl8
lut &inc8 &lx &lx
copy &ix[0:8] &lx
goto &ebl
:ebend block
ret

# --- a layer for each patch of a lut or store: the patches of the fields of the row, a layer with nothing but the jump, the row
# (the data: tn, tks, tout, tj, tbl, tadr, tchar; the addresses qa[0..tn]; lmode 0 lut, 1 store)
:lutgen word
lut &mm &tn[0:2] &ro
copy &wxa &pos
copy &wxb &ro
call &wadd &xq32
:xq32 block
copy &t1 &wxr
copy &ra &t1[0:20]
lut &fa &lmode &f1
lut &fb &lmode &f2
copy &wxa &ra
copy &wxb &f1
call &wadd &xq33
:xq33 block
copy &t1 &wxr
copy &wxa &t1[0:20]
copy &wxb &tj
call &wadd &xq34
:xq34 block
copy &b1 &wxr
copy &wxa &ra
copy &wxb &f2
call &wadd &xq35
:xq35 block
copy &t1 &wxr
copy &wxa &t1[0:20]
copy &wxb &tj
call &wadd &xq36
:xq36 block
copy &b2 &wxr
copy &off &z20
copy &li &zero8
goto &lgl
:lgl block
eq &li &tn &q2
if &q2[1] &lgend &lgb
:lgb block
lut &tks &li[0:2] &kk
lut &qa &li[0:2] &qd1
copy &kk20[0:4] &kk
copy &wxa &b1[0:20]
copy &wxb &off
call &wadd &xq37
:xq37 block
copy &t1 &wxr
copy &p2 &t1[0:20]
copy &p1 &kk20
copy &p3 &qd1
call &lc &lg2
:lg2 block
copy &wxa &b2[0:20]
copy &wxb &off
call &wadd &xq38
:xq38 block
copy &t1 &wxr
copy &p2 &t1[0:20]
copy &p1 &kk20
copy &p3 &qd1
call &lc &lg3
:lg3 block
copy &wxa &off
copy &wxb &kk20
call &wadd &xq39
:xq39 block
copy &t1 &wxr
copy &off &t1[0:20]
lut &inc8 &li &li
goto &lgl
:lgend block
call &pgap &lg4
:lg4 block
lut &qa &tn[0:2] &qd1
copy &p1 &tout20
if &lmode &lgs &lgl2
:lgl2 block
copy &p2 &qd1
if &tbl &lgl3 &lgl4
:lgl3 block
copy &lk3 &y1
goto &lgl5
:lgl4 block
copy &p3 &tadr
goto &lgl5
:lgl5 block
call &lc &lgret
:lgs block
copy &p3 &qd1
if &tbl &lgs1 &lgs2
:lgs1 block
copy &lk2 &y1
goto &lgs3
:lgs2 block
copy &p2 &tadr
goto &lgs3
:lgs3 block
call &lc &lgret
:lgret block
ret

# --- the action of a word whose arguments are all in (wd is its code): the tree of the code
:act word
if &wd[4] &act1x &act0x
:act1x block
lut &or2 &wd[1:3] &q1
if &q1 &a_lib &act1y
:act1y block
if &wd[3] &a_long &act1z
:act1z block
if &wd[0] &a_key &a_warn
:act0x block
if &wd[3] &act8 &act0
:act8 block
if &wd[2] &act12 &act8b
:act8b block
if &wd[1] &act10 &act8c
:act8c block
if &wd[0] &a_word &a_block
:act10 block
if &wd[0] &a_if &a_goto
:act12 block
if &wd[1] &act14 &act12b
:act12b block
if &wd[0] &a_ret &a_call
:act14 block
if &wd[0] &a_emit &a_halt
:act0 block
if &wd[2] &act4 &a_copy
:act4 block
if &wd[1] &act6 &act4b
:act4b block
if &wd[0] &a_shr &a_shl
:act6 block
if &wd[0] &a_store &a_lut

:actret block
ret

:a_block block
copy &coded &one1
emit &s_cb
copy &pnm &lbl
call &pname &ab2
:ab2 block
emit &nl8
copy &bopen &one1
ret

:a_word block
copy &coded &one1
copy &q &z20
call &chk &aw1
:aw1 block
emit &s_cr
copy &pnm &lbl
call &pname &aw2
:aw2 block
emit &nl8
emit &s_z28
copy &wxa &pos
copy &wxb &c40
call &wadd &xq40
:xq40 block
copy &pr &wxr
copy &pos &pr[0:20]
emit &s_cb
copy &pnm &lbl
call &pname &aw3
:aw3 block
emit &nl8
copy &curw &lbl
copy &hasw &one1
copy &bopen &one1
ret

:a_copy block
lut &av &k0i &ga
lut &av &k1i &gb
copy &wxa &ga[20:40]
copy &wxb &gb[20:40]
call &weq &xq41
:xq41 block
if &q5[4] &ac2 &wid
:ac2 block
copy &q &z20
call &chk &ac3
:ac3 block
copy &p1 &ga[20:40]
copy &p2 &ga[0:20]
copy &p3 &gb[0:20]
call &lc &actret

:a_emit block
copy &qd1 &cs2
goto &a_out
:a_warn block
copy &qd1 &cs3
goto &a_out
:a_out block
lut &av &k0i &ga
copy &q &z20
call &chk &ao2
:ao2 block
copy &qd2 &qd1
copy &qd3 &ga[0:20]
copy &wxa &ga[0:20]
copy &wxb &ga[20:40]
call &wadd &xq42
:xq42 block
copy &s21 &wxr
copy &qd4 &s21[0:20]
call &lq &actret

:a_key block
lut &av &k0i &ga
lut &nz3 &ga[20:23] &q1
if &q1 &wid &ak2
:ak2 block
copy &q &z20
call &chk &ak3
:ak3 block
copy &qd1 &ga[0:20]
copy &wxa &ga[0:20]
copy &wxb &ga[20:40]
call &wadd &xq43
:xq43 block
copy &s21 &wxr
copy &qd2 &s21[0:20]
copy &qd3 &cs1
copy &qd4 &cs1
call &lq &actret

:a_goto block
copy &q &z20
call &chk &ag2
:ag2 block
copy &jtv &y1
copy &bopen &zero
call &lastx &actret
:a_halt block
copy &q &z20
call &chk &ah2
:ah2 block
copy &jtv &y2
copy &bopen &zero
call &lastx &actret

# long! pos src, long@ pos dst (language 4; wd[0]: 0 put, 1 get): pos has 128 bits, the data at most NMAX (cnmax); the line `long` and one layer with the row of the
# four numbers n (bit 19: get), the address of pos, the address of the data, the position of the layer, and ten layers of room for the pass l4p (c1600); add4 is used
:a_long block
lut &av &k0i &ga
lut &av &k1i &gb
copy &wxa &ga[20:40]
copy &wxb &c128
call &weq &xq77
:xq77 block
if &q5[4] &lo1 &wid
:lo1 block
copy &wxa &cnmax
copy &wxb &gb[20:40]
call &wlt &xq78
:xq78 block
if &ltc[5] &big &lo2
:lo2 block
copy &q &z20
call &chk &lo3
:lo3 block
store &bua &k0i &one1
emit &s_long
copy &qd1 &gb[20:40]
copy &qd1[19] &wd[0]
copy &qd2 &ga[0:20]
copy &qd3 &gb[0:20]
copy &qd4 &pos
call &lq &lo4
:lo4 block
copy &wxa &pos
copy &wxb &c1600
call &wadd &xq79
:xq79 block
copy &s21 &wxr
copy &pos &s21[0:20]
ret

# call w b: copy the link into the return link of w, then jump to w; the link (the pair of b) follows the last layer
:a_call block
copy &q &z20
call &chk &acl1
:acl1 block
emit &s_c28r
copy &pnm &bn0
call &pname &acl2
:acl2 block
emit &sp
copy &wxa &pos
copy &wxb &c320
call &wadd &xq44
:xq44 block
copy &pr &wxr
copy &h &pr[0:20]
call &puthex &acl3
:acl3 block
emit &nl8
call &pjump &acl4
:acl4 block
copy &jtv &y1
call &lastx &acl5
:acl5 block
emit &s_d14b
copy &pnm &bn1
call &pname &acl6
:acl6 block
emit &nl8
emit &s_d14b
copy &pnm &bn1
call &pname &acl7
:acl7 block
emit &s_plus
copy &wxa &pos
copy &wxb &c40
call &wadd &xq45
:xq45 block
copy &pr &wxr
copy &pos &pr[0:20]
copy &bopen &zero
ret

# ret: copy the return link of the word into the jump row of the last layer, one layer in between, the last layer
:a_ret block
copy &q &z20
call &chk &ar1
:ar1 block
emit &s_c28
copy &wxa &pos
copy &wxb &c440
call &wadd &xq46
:xq46 block
copy &pr &wxr
copy &h &pr[0:20]
call &puthex &ar2
:ar2 block
emit &sp
emit &s_ar
copy &pnm &curw
call &pname &ar3
:ar3 block
emit &nl8
call &pjump &ar4
:ar4 block
call &pgap &ar5
:ar5 block
copy &jtv &y3
copy &bopen &zero
call &lastx &actret

# if c b1 b2: patch the index into the row, a layer, the row which copies the pair into the jump of the last layer (6 layers); the
# table of two pairs (other, then) follows, at a multiple of 128 bits
:a_if block
lut &av &k0i &ga
copy &wxa &ga[20:40]
copy &wxb &one20
call &weq &xq47
:xq47 block
if &q5[4] &ai2 &wid
:ai2 block
copy &q &z20
call &chk &ai3
:ai3 block
copy &possv &pos
copy &wxa &pos
copy &wxb &c960
call &wadd &xq48
:xq48 block
copy &pr &wxr
copy &pos &pr[0:20]
copy &ale &c7e
call &padcalc &ai4
:ai4 block
copy &wxa &pos
copy &wxb &pad
call &wadd &xq49
:xq49 block
copy &pr &wxr
copy &tabv &pr[0:20]
copy &pos &possv
copy &wxa &pos
copy &wxb &c526
call &wadd &xq50
:xq50 block
copy &pr &wxr
copy &p2 &pr[0:20]
copy &p1 &one20
copy &p3 &ga[0:20]
call &lc &ai5
:ai5 block
copy &wxa &pos
copy &wxb &c386
call &wadd &xq51
:xq51 block
copy &pr &wxr
copy &p2 &pr[0:20]
copy &p1 &one20
copy &p3 &ga[0:20]
call &lc &ai6
:ai6 block
call &pgap &ai7
:ai7 block
copy &p1 &c40
copy &wxa &pos
copy &wxb &c440
call &wadd &xq52
:xq52 block
copy &pr &wxr
copy &p2 &pr[0:20]
copy &p3 &tabv
call &lc &ai8
:ai8 block
call &pgap &ai9
:ai9 block
copy &jtv &y3
call &lastx &ai10
:ai10 block
copy &ale &c7e
call &align &ai11
:ai11 block
emit &s_d14b
copy &pnm &bn1
call &pname &ai12
:ai12 block
emit &nl8
emit &s_d14b
copy &pnm &bn1
call &pname &ai13
:ai13 block
emit &s_plus
emit &s_z18
emit &s_d14b
copy &pnm &bn0
call &pname &ai14
:ai14 block
emit &nl8
emit &s_d14b
copy &pnm &bn0
call &pname &ai15
:ai15 block
emit &s_plus
emit &s_z18
copy &wxa &pos
copy &wxb &c128
call &wadd &xq53
:xq53 block
copy &pr &wxr
copy &pos &pr[0:20]
copy &bopen &zero
ret

# lut and store: the widths of the indices and of the entry, then the addresses go to qa and the layers out
:a_lut block
copy &lmode &zero
goto &a_ls
:a_store block
copy &lmode &one1
goto &a_ls
:a_ls block
copy &li &zero8
goto &wl
:wl block
eq &li &tn &q2
if &q2[1] &wlo &wlb
:wlb block
lut &av &li[0:3] &ga
lut &tks &li[0:2] &kk
copy &kk20[0:4] &kk
copy &wxa &ga[20:40]
copy &wxb &kk20
call &weq &xq54
:xq54 block
if &q5[4] &wl2 &wid
:wl2 block
lut &inc8 &li &li
goto &wl
:wlo block
lut &av &li[0:3] &ga
copy &wxa &ga[20:40]
copy &wxb &tout20
call &weq &xq55
:xq55 block
if &q5[4] &wl3 &wid
:wl3 block
copy &q &z20
call &chk &wl4
:wl4 block
copy &ci8 &zero8
goto &wql
:wql block
lut &av &ci8[0:3] &ga
store &qa &ci8[0:2] &ga[0:20]
eq &ci8 &tn &q2
if &q2[1] &wgo &wq2
:wq2 block
lut &inc8 &ci8 &ci8
goto &wql
:wgo block
call &lutgen &actret

# shl x r k, shr x r k: copies and the bits of zero (the shared zero part of space is at 160)
:a_shl block
copy &dir &zero
goto &a_sh
:a_shr block
copy &dir &one1
goto &a_sh
:a_sh block
lut &av &k0i &ga
lut &av &k1i &gb
lut &av &k2i &gc
copy &wxa &ga[20:40]
copy &wxb &gb[20:40]
call &weq &xq56
:xq56 block
if &q5[4] &sh2 &wid
:sh2 block
copy &q &z20
call &chk &sh3
:sh3 block
copy &kv20 &gc[0:20]
copy &wxa &kv20
copy &wxb &ga[20:40]
call &wlt &xq57
:xq57 block
if &ltc[5] &sh4 &sh3b
:sh3b block
copy &kv20 &ga[20:40]
goto &sh4
:sh4 block
copy &wxa &kv20
copy &wxb &ga[20:40]
call &wlt &xq58
:xq58 block
copy &lkn &ltc[5]
copy &wxa &kv20
copy &wxb &z20
call &weq &xq59
:xq59 block
copy &kz &q5[4]
copy &wxa &ga[20:40]
copy &wxb &kv20
call &wsub &xq60
:xq60 block
copy &s21 &wxr
copy &nmk &s21[0:20]
if &lkn &sh5 &sh7
:sh5 block
copy &p1 &nmk
if &dir &sh5r &sh5l
:sh5l block
copy &wxa &gb[0:20]
copy &wxb &kv20
call &wadd &xq61
:xq61 block
copy &s21 &wxr
copy &p2 &s21[0:20]
copy &p3 &ga[0:20]
goto &sh6
:sh5r block
copy &p2 &gb[0:20]
copy &wxa &ga[0:20]
copy &wxb &kv20
call &wadd &xq62
:xq62 block
copy &s21 &wxr
copy &p3 &s21[0:20]
goto &sh6
:sh6 block
call &lc &sh7
:sh7 block
if &kz &actret &sh8
:sh8 block
copy &p1 &kv20
copy &p3 &zaddr
if &dir &sh8r &sh8l
:sh8l block
copy &p2 &gb[0:20]
call &lc &actret
:sh8r block
copy &wxa &gb[0:20]
copy &wxb &nmk
call &wadd &xq63
:xq63 block
copy &s21 &wxr
copy &p2 &s21[0:20]
call &lc &actret

# add sub band lt eq x y r: one lut for each nibble (the parameters of the word are in the table lp)
:a_lib block
lut &av &k0i &ga
lut &av &k1i &gb
lut &av &k2i &gc
lut &lp &wd[0:5] &lpv
lut &or2 &ga[20:22] &q1
if &q1 &wid &al2
:al2 block
copy &wxa &ga[20:40]
copy &wxb &gb[20:40]
call &weq &xq64
:xq64 block
if &q5[4] &al3 &wid
:al3 block
shr &ga[20:40] &kq 2
if &lpv[13] &alr23 &alr01
:alr01 block
if &lpv[12] &alr1 &alr0
:alr0 block
copy &wxa &ga[20:40]
copy &wxb &one20
call &wadd &xq65
:xq65 block
copy &s21 &wxr
copy &wantv &s21[0:20]
goto &alcmp
:alr1 block
copy &wantv &ga[20:40]
