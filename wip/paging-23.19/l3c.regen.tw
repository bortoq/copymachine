:main block
goto &init

# --- the start: the first lines of the text, the symbols of the tool (add4 .. hex4, zero)
:init block
goto &iloop
:iloop block
lut &bn &ki7[0:2] &bnv
copy &nm[0:80] &z80
copy &nm[80:112] &bnv
lut &bk &ki7[0:2] &ikind
lut &ba &ki7[0:2] &bav
copy &iaddr[0:8] &bav
copy &iaddr[8:20] &z20[0:12]
if &ikind[2] &ibi &izero
:ibi block
lut &bi &bav[0:3] &iinfo
call &insert &inext
:izero block
copy &iinfo &one19
call &insert &inext
:inext block
lut &inc8 &ki7 &ki7
eq &ki7 &c4 &q2
if &q2[1] &read &iloop

# --- a character: the class (bits: 0 zero byte, 1 blank, 2 line break, 3 #, 4 ", 5 \, 6 :, 7 &, 8 [, 9 ], 10 digit,
# 11 letter digit or _, 12-15 the value of a digit)
:read block
key &ch
lut &cls &ch &cl
lut &or2 &cl[0:2] &sep
if &sq &instr &r1
:r1 block
if &sclose &afterq &r2
:r2 block
if &cm &incm &r3
:r3 block
if &sep &sepc &r4
:r4 block
if &tf[5] &intok &idle

# --- inside a string: an escape, the closing quote, a character
:instr block
if &esc &escc &i1
:escc block
lut &escv &ch &ev
copy &esc &zero
if &ev[8] &escok &bad
:escok block
copy &ch &ev[0:8]
goto &sadd
:i1 block
if &cl[4] &sclosed &i2
:sclosed block
copy &sq &zero
copy &sclose &one1
goto &read
:i2 block
if &cl[5] &sbs &i3
:sbs block
copy &esc &one1
goto &read
:i3 block
if &cl[0] &bad &sadd
:sadd block
if &slen[5] &bad &sadd2
:sadd2 block
store &sb &slen[0:5] &ch
lut &inc8 &slen &slen
goto &read
:afterq block
if &sep &sepc &bad

# --- a comment (to the end of the line or of the text)
:incm block
if &cl[2] &cmend &incm2
:cmend block
copy &cm &zero
goto &read
:incm2 block
if &cl[0] &eot &read

# --- a blank or the zero byte: the token ends
:sepc block
if &tf[5] &sepc1 &sepc2
:sepc1 block
call &tokend &sepc2
:sepc2 block
if &cl[0] &eot &read

# --- between tokens: a comment, a label, a reference, a string, a number, a name
:idle block
if &cl[3] &hash &id1
:hash block
copy &cm &one1
goto &read
:id1 block
if &cl[6] &stlabel &id2
:stlabel block
copy &tf &tl6
call &clrname &read
:id2 block
if &cl[7] &stref &id3
:stref block
copy &tf &tr6
copy &rf &z6[0:5]
call &clrname &read
:id3 block
if &cl[4] &stq &id4
:stq block
copy &tf &ts6
copy &sq &one1
copy &esc &zero
copy &slen &zero8
goto &read
:id4 block
if &cl[10] &stnum &id5
:stnum block
copy &tf &tn6
copy &num &z20
call &dacc &read
:id5 block
if &cl[11] &stname &bad
:stname block
copy &tf &tw6
call &clrname &nameadd

# --- inside a token: a number, a reference, a name or a label
:intok block
if &tf[2] &tnum &it1
:tnum block
if &cl[10] &tnum2 &bad
:tnum2 block
call &dacc &read
:it1 block
if &tf[4] &refc &it2
:it2 block
if &cl[11] &nameadd &it3
:it3 block
if &cl[16] &it4 &bad
:it4 block
if &tf[1] &nameadd &bad

# a character of a name (not a digit first, at most 14 bytes)
:nameadd block
if &nz &nameadd2 &nafirst
:nafirst block
if &cl[10] &bad &nameadd2
:nameadd2 block
lut &is14 &nlen[0:4] &q1
if &q1 &bad &nameadd3
:nameadd3 block
copy &nt[0:104] &nm[8:112]
copy &nt[104:112] &ch
copy &nm &nt
lut &inc8 &nlen &nlen
lut &nzt &nlen[0:4] &nz
goto &read

# a reference: the name, then [lo] or [lo:hi], then the end (rf: 0 in the brackets, 1 after the colon, 2 closed, 3 a digit
# was there, 4 brackets)
:refc block
if &rf[2] &bad &rf1
:rf1 block
if &rf[0] &rfn &rfname
:rfname block
if &cl[8] &lbr &rfn2
:rfn2 block
if &cl[11] &nameadd &bad
:lbr block
if &nz &lbr2 &bad
:lbr2 block
copy &rf &lbrv
copy &num &z20
goto &read
:rfn block
if &cl[10] &rdig &rf2
:rdig block
copy &rf[3] &one1
call &dacc &read
:rf2 block
if &cl[6] &rcolon &rf3
:rcolon block
if &rf[1] &bad &rcolon2
:rcolon2 block
if &rf[3] &rcolon3 &bad
:rcolon3 block
copy &lov &num
copy &rf[1] &one1
copy &rf[3] &zero
copy &num &z20
goto &read
