# Reads a and b (16 bits each) from stdin; prints a-b (16 bits), the borrow, a==b, a<<1, a>>1,
# a<<7, a>>9, all in hex (progs.arith(16, 7, 9)). eq leaves "equal" in the last bit of e.
:a data 16 0
:b data 16 0
:d data 17 0
:e data 4 0
:f1 data 4 0
:f2 data 4 0
:s0 data 16 0
:s1 data 16 0
:s2 data 16 0
:s3 data 16 0
:main block
key &a[0:8]
key &a[8:16]
key &b[0:8]
key &b[8:16]
sub &a &b &d
eq &a &b &e
shl &a &s0 1
shr &a &s1 1
shl &a &s2 7
shr &a &s3 9
copy &f1[0:1] &d[16]
copy &f2[0:1] &e[3]
:d_3 data 8 0
lut &hex4 &d[12:16] &d_3
emit &d_3
:d_2 data 8 0
lut &hex4 &d[8:12] &d_2
emit &d_2
:d_1 data 8 0
lut &hex4 &d[4:8] &d_1
emit &d_1
:d_0 data 8 0
lut &hex4 &d[0:4] &d_0
emit &d_0
:f1_0 data 8 0
lut &hex4 &f1[0:4] &f1_0
emit &f1_0
:f2_0 data 8 0
lut &hex4 &f2[0:4] &f2_0
emit &f2_0
:s0_3 data 8 0
lut &hex4 &s0[12:16] &s0_3
emit &s0_3
:s0_2 data 8 0
lut &hex4 &s0[8:12] &s0_2
emit &s0_2
:s0_1 data 8 0
lut &hex4 &s0[4:8] &s0_1
emit &s0_1
:s0_0 data 8 0
lut &hex4 &s0[0:4] &s0_0
emit &s0_0
:s1_3 data 8 0
lut &hex4 &s1[12:16] &s1_3
emit &s1_3
:s1_2 data 8 0
lut &hex4 &s1[8:12] &s1_2
emit &s1_2
:s1_1 data 8 0
lut &hex4 &s1[4:8] &s1_1
emit &s1_1
:s1_0 data 8 0
lut &hex4 &s1[0:4] &s1_0
emit &s1_0
:s2_3 data 8 0
lut &hex4 &s2[12:16] &s2_3
emit &s2_3
:s2_2 data 8 0
lut &hex4 &s2[8:12] &s2_2
emit &s2_2
:s2_1 data 8 0
lut &hex4 &s2[4:8] &s2_1
emit &s2_1
:s2_0 data 8 0
lut &hex4 &s2[0:4] &s2_0
emit &s2_0
:s3_3 data 8 0
lut &hex4 &s3[12:16] &s3_3
emit &s3_3
:s3_2 data 8 0
lut &hex4 &s3[8:12] &s3_2
emit &s3_2
:s3_1 data 8 0
lut &hex4 &s3[4:8] &s3_1
emit &s3_1
:s3_0 data 8 0
lut &hex4 &s3[0:4] &s3_0
emit &s3_0
halt
