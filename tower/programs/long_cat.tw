# cat: the area 1 (the file -r) is read in 5 chunks of 8 bytes, every chunk goes to stdout. The address of the host is a constant of the text,
# so the five reads are written one by one: the positions are the bits 0, 64, 128, 192, 256 of the area 1.
:buf data 64 "????????"
:main block
copy &buf 0x100000001000000000000000000000000
emit &buf
copy &buf 0x100000001000000000000000000000040
emit &buf
copy &buf 0x100000001000000000000000000000080
emit &buf
copy &buf 0x1000000010000000000000000000000c0
emit &buf
copy &buf 0x100000001000000000000000000000100
emit &buf
halt
