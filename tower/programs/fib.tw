# Fibonacci of the byte n from stdin by double recursion (progs.fib()).
# rs keeps the return links (link: the width of a reference, 2A bits), ds the saved values.
:rs stack 4 link
:ds stack 4 8
rec &fib &rs
:n data 8 0
:r data 8 0
:t data 8 0
:one8 data 8 1
:two8 data 8 2
:c data 3 0
:s data 9 0
:main block
key &n
call &fib &show
:show block
:dig data 12 0
:buf data 32 "000\n"
lut &dec8 &r &dig
copy &buf[4:8] &dig[0:4]
copy &buf[12:16] &dig[4:8]
copy &buf[20:24] &dig[8:12]
emit &buf
halt
:fib word
lt &n &two8 &c
if &c[2] &base &more
:base block
copy &r &n
ret
:more block
push &ds &n
sub &n &one8 &s
copy &n &s[0:8]
call &fib &back1
:back1 block
pop &ds &t
push &ds &r
sub &t &two8 &s
copy &n &s[0:8]
call &fib &back2
:back2 block
pop &ds &t
add &r &t &s
copy &r &s[0:8]
ret
