# the row of op bx goes out: c n d s, or four lines d 14 x; a number that points into the old block or after it is moved
:prow word
lut &xu &bx &bu
lut &ukind &bu &kd
if &kd[1] &pq0 &pc0
:pq0 block
emit &s_d14
lut &un &bu &h
call &puthex &pq1
:pq1 block
emit &nl8
emit &s_d14
lut &ud &bu &h
call &puthex &pq2
:pq2 block
emit &nl8
emit &s_d14
lut &us &bu &h
call &puthex &pq3
:pq3 block
emit &nl8
emit &s_d14
lut &uq3 &bu &h
call &puthex &pq4
:pq4 block
emit &nl8
ret
:pc0 block
emit &s_c
lut &un &bu &h
call &puthex &pc1
:pc1 block
emit &sp
lut &ulk &bu &lk
lut &or2 &lk[0:2] &q1
if &q1 &pc2 &pc3
:pc2 block
lut &udta &bu &pnm[0:64]
lut &udtb &bu &pnm[64:128]
call &ptxt &pc5
:pc3 block
lut &ud &bu &rv
call &remap &pc4
:pc4 block
copy &h &rn
call &puthex &pc5
:pc5 block
emit &sp
lut &or2 &lk[2:4] &q1
if &q1 &pc6 &pc7
:pc6 block
lut &usta &bu &pnm[0:64]
lut &ustb &bu &pnm[64:128]
call &ptxt &pc9
:pc7 block
lut &us &bu &rv
call &remap &pc8
:pc8 block
copy &h &rn
call &puthex &pc9
:pc9 block
emit &nl8
ret

# rn = the new place of rv: before the block it stays; in the block it is the place of the same bit of the same row (or of the jump of the
# last layer); after the block (the table of `if`, the pair of `call`) it moves with the end of the block; the channels stay
:remap word
copy &aa &rv
copy &ab &bs
call &ltw &rm1
:rm1 block
if &lr &rmsame &rm2
:rm2 block
copy &aa &rv
copy &ab &be
call &ltw &rm3
:rm3 block
if &lr &rmcode &rm4
:rm4 block
copy &aa &rv
copy &ab &limc
call &ltw &rm5
:rm5 block
if &lr &rmtail &rmsame
:rmsame block
copy &rn &rv
ret
:rmtail block
copy &aa &rv
copy &ab &shift20
call &addw &rm6
:rm6 block
copy &rn &ar
ret
:rmcode block
copy &aa &rv
copy &ab &bs
call &subw &rm7
:rm7 block
copy &dvv &ar
call &div160 &rm8
:rm8 block
copy &aa &dr
copy &ab &c80
call &ltw &rm9
:rm9 block
if &lr &rmrow &rmjmp
:rmrow block
lut &ux &dq[0:8] &ux8
eq &ux8 &c255b &q2
if &q2[1] &bad &rmrow2
:rmrow2 block
lut &ox &ux8 &tv
copy &aa &tv
copy &ab &dr
call &addw &rm10
:rm10 block
copy &rn &ar
ret
:rmjmp block
copy &aa &nlay
copy &ab &one20
call &subw &rm11
:rm11 block
lut &lst &ar[0:10] &tv
lut &lcnt &ar[0:10] &rcn
lut &mu &rcn &kk20
copy &aa &tv
copy &ab &kk20
call &addw &rm12
:rm12 block
copy &aa &ar
copy &ab &dr
call &addw &rm13
:rm13 block
copy &aa &ar
copy &ab &c80
call &subw &rm14
:rm14 block
copy &rn &ar
ret

# --- the arithmetic of 20 bits as words (a copy of the arguments and a call cost less than a chain of five tables for each use)
:wadd word
add &wxa &wxb &wxr
ret
:wsub word
sub &wxa &wxb &wxr
ret
:wlt word
lt &wxa &wxb &ltc
ret
:weq word
eq &wxa &wxb &q5
ret
