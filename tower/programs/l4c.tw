:c204 data 20 204
:c2048 data 20 2048
:c6 data 4 6
:c5v data 3 5
:c63 data 8 63
:sp data 8 " "
:nl8 data 8 "\n"
:s_amp data 8 "&"
:s_lb data 8 "["
:s_rbk data 8 "]"
:s_colon data 8 ":"
:s_0 data 8 "0"
:s_x data 8 "x"
:w_copy data 32 "copy"
:w_pack data 32 "pack"
:w_data data 32 "data"
:s_copy4 data 32 "copy"
:s_copy data 40 "copy "
:s_cq data 80 "copy &l4q["
:s_rb data 16 "] "
:s_z1 data 232 "copy &l4q[0:204] &l4z[0:204]\n"
:s_cq204 data 112 "copy &l4q[204:"
:s_sys1 data 160 "copy 1048570 &l4q[0:"
:s_rbn data 16 "]\n"
:s_sys2 data 200 "copy 1048570 &l4q[0:204]\n"
:s_rsys data 80 "] 1048570\n"
:s_q204 data 80 " &l4q[204:"
:p1 data 144 "\n:l4q data 2252 0\n"
:p2 data 128 ":l4z data 204 0\n"
:p3 data 168 ":l4n0 data 20 274960\n"
:p4 data 168 ":l4n1 data 20 624485\n"
:p5 data 168 ":l4n2 data 20 974010\n"
:p6 data 136 ":l4n3 data 20 15\n"

:main block
goto &rd

# --- a character: the class (bits: 0 zero byte, 1 blank, 2 #, 3 ", 4 backslash, 5 line break, 6 letter digit or _, 7 digit)
:rd block
key &ch
lut &cc &ch &cl
if &cl[0] &eot &rd1
:rd1 block
if &incm &rcom &rd2
# in a comment: it goes out; the end of the line ends it
:rcom block
emit &ch
if &cl[5] &rcend &rd
:rcend block
copy &incm &zero
goto &rd
:rd2 block
if &instr &rstr &rd3
# in a string: an escape, the closing quote, a character
:rstr block
call &tkadd &rs2
:rs2 block
if &esc &resc &rs3
:resc block
copy &esc &zero
goto &rd
:rs3 block
if &cl[4] &rsbs &rs4
:rsbs block
copy &esc &one1
goto &rd
:rs4 block
if &cl[3] &rsq &rd
:rsq block
copy &instr &zero
goto &rd
:rd3 block
if &intk &rtok &ridle
# in a token: a blank ends it (and goes out after it), a character is added
:rtok block
if &cl[1] &rsep &rt2
:rt2 block
call &tkadd &rd
:rsep block
call &tokend &rsep2
:rsep2 block
copy &intk &zero
if &cw[0] &rd &rsep3
:rsep3 block
if &cw[1] &rd &rsep4
:rsep4 block
emit &ch
goto &rd
# between tokens: a blank goes out, a comment, the start of a token
:ridle block
if &cl[1] &rblank &ri2
:rblank block
if &cw[0] &rd &rblank2
:rblank2 block
if &cw[1] &rd &rblank3
:rblank3 block
emit &ch
goto &rd
:ri2 block
if &cl[2] &rhash &rstart
:rhash block
copy &incm &one1
emit &ch
goto &rd
:rstart block
copy &intk &one1
copy &tl &zero8
copy &bb &cw[1]
copy &alld &one1
copy &num &z20
if &cl[3] &rsq0 &rst2
:rsq0 block
copy &instr &one1
copy &esc &zero
goto &rst2
:rst2 block
call &tkadd &rd

# --- the end of the text: the token in hand ends, the prelude if it has not gone out, the held copy, the zero byte
:eot block
if &intk &eot1 &eot2
:eot1 block
call &tokend &eot2
:eot2 block
call &prel &eot3
:eot3 block
if &cw[1] &eot4 &eot5
:eot4 block
emit &s_copy
copy &ob &zero
copy &ol &l1
call &emitop &eot7
:eot5 block
if &cw[0] &eot6 &eot7
:eot6 block
emit &s_copy4
goto &eot7
:eot7 block
emit &zero8
halt

# --- a character into the token: at most 120 are stored; a digit goes into num while all the characters are digits
:tkadd word
lut &tlok &tl[0:7] &q1
if &q1 &ta1 &tadone
:ta1 block
copy &ti[0:7] &tl[0:7]
copy &ti[7] &bb
store &tk &ti &ch
lut &inc8 &tl &tl
if &alld &ta2 &tadone
:ta2 block
if &cl[7] &ta3 &ta4
:ta4 block
copy &alld &zero
goto &tadone
:ta3 block
lut &hexv &ch &hv
shl &num &nn 3
shl &num &nn2 1
copy &wxa &nn
copy &wxb &nn2
call &wadd &ta5
:ta5 block
copy &s21 &wxr
copy &wxa &s21[0:20]
copy &wxb &z20
copy &wxb[0:4] &hv[0:4]
call &wadd &ta6
:ta6 block
copy &num &wxr[0:20]
goto &tadone
:tadone block
ret

# --- a token ends (base 0: a token of its own or the first operand of a copy; the second operand is at base 1)
:tokend word
if &cw[1] &tdo2 &td1
:td1 block
if &cw[0] &tdo1 &tdr
# the first operand of a copy is held
:tdo1 block
copy &l1 &tl
copy &cw &y2
copy &tr &y0
ret
# the second: the copy goes out
:tdo2 block
copy &l2 &tl
copy &cw &y0
copy &tr &y0
call &trans &tdx
:tdx block
ret
# a token of its own: the first four characters, `pack` `copy` `data`
:tdr block
copy &isp &zero
copy &isc &zero
copy &isd &zero
eq &tl &c4 &q2
if &q2[1] &tdr1 &tdr3
:tdr1 block
lut &tk &i0 &tc
copy &w32[0:8] &tc
lut &tk &i1 &tc
copy &w32[8:16] &tc
lut &tk &i2 &tc
copy &w32[16:24] &tc
lut &tk &i3 &tc
copy &w32[24:32] &tc
eq &w32 &w_pack &fp
copy &isp &fp[7]
eq &w32 &w_copy &fp
copy &isc &fp[7]
eq &w32 &w_data &fp
copy &isd &fp[7]
goto &tdr3
:tdr3 block
if &first &tdf &tdc
# the first token: `pack` stays the first, the prelude comes after it
:tdf block
copy &first &zero
if &isp &tdf1 &tdf2
:tdf1 block
call &emittok &tdf3
:tdf3 block
call &prel &tdx
:tdf2 block
call &prel &tdc
:tdc block
if &isc &tdcopy &tdout
# `copy` is held with its two operands
:tdcopy block
copy &cw &y1
copy &tr &y0
ret
:tdout block
call &emittok &tdo3
:tdo3 block
call &track &tdx

# the token (base 0, tl characters) goes out
:emittok word
copy &ob &zero
copy &ol &tl
call &emitop &emx
:emx block
ret

# the operand (ob, ol) goes out
:emitop word
copy &ii &zero8
goto &eol
:eol block
eq &ii &ol &q2
if &q2[1] &eodone &eo1
:eo1 block
copy &ti[0:7] &ii[0:7]
copy &ti[7] &ob
lut &tk &ti &tc
emit &tc
lut &inc8 &ii &ii
goto &eol
:eodone block
ret

# the prelude, once
:prel word
if &pdone &prelx &prel1
:prelx block
ret
:prel1 block
copy &pdone &one1
emit &p1
emit &p2
emit &p3
emit &p4
emit &p5
emit &p6
ret

# --- the names of data: the token which went out is looked at: `:name`, `data`, the width (tr: 0 nothing, 1 after :name, 2 after :name data)
:track word
if &tr[1] &trk2 &trk01
:trk2 block
copy &tr &y0
if &alld &trk2a &trkend
:trk2a block
eq &tl &zero8 &q2
if &q2[1] &trkend &trk2b
:trk2b block
copy &nm &lbl
copy &hh &lh
call &find &trk2c
# the first definition of a name stays; no free cell or node: the name is not kept
:trk2c block
if &fo &trkend &trk2d
:trk2d block
eq &ncl &c63 &q2
if &q2[1] &trkend &trk2e
:trk2e block
lut &inc8 &ncl &nc
call &tins &trk2f
:trk2f block
if &tok &trk2g &trkend
:trk2g block
copy &ncl &nc
store &sna &nc[0:6] &lbl[0:56]
store &snb &nc[0:6] &lbl[56:112]
store &swd &nc[0:6] &num
store &scp &nc[0:6] &ot[0:6]
ret
:trk01 block
if &tr[0] &trk1 &trk0
:trk1 block
if &isd &trk1d &trk0
:trk1d block
copy &tr &y2
ret
:trk0 block
copy &tr &y0
lut &tk &i0 &tc
eq &tc &s_colon &q2
if &q2[1] &trkl &trkend
:trkl block
copy &ob &zero
copy &ol &tl
copy &mi &one8
call &mkname &trkl2
:trkl2 block
if &nok &trkl3 &trkend
:trkl3 block
eq &mi &tl &q2
if &q2[1] &trkl4 &trkend
:trkl4 block
copy &lbl &nm
copy &lh &hh
copy &tr &y1
ret
:trkend block
ret

# --- the two operands of a copy: which is the host, the width, the text
:trans word
copy &ob &zero
copy &ol &l1
call &ishost &tr1
:tr1 block
copy &h1 &hok
copy &ob &one1
copy &ol &l2
call &ishost &tr2
:tr2 block
copy &h2 &hok
copy &q2[0] &h1
copy &q2[1] &h2
lut &xor2 &q2 &q1
if &q1 &tr3 &trun
:tr3 block
if &h1 &tr4 &tr5
:tr4 block
copy &xb &one1
copy &xl &l2
copy &hb &zero
copy &hl &l1
goto &tr6
:tr5 block
copy &xb &zero
copy &xl &l1
copy &hb &one1
copy &hl &l2
goto &tr6
:tr6 block
copy &ob &xb
copy &ol &xl
call &opwidth &tr7
:tr7 block
if &wok &tr8 &trun
:tr8 block
copy &wxa &wv
copy &wxb &z20
call &weq &tr9
:tr9 block
if &q5[4] &trun &tr10
:tr10 block
copy &wxa &c2048
copy &wxb &wv
call &wlt &tr11
:tr11 block
if &ltc[5] &trun &tr12
:tr12 block
copy &hput &h1
call &hostcopy &trx
:trx block
ret
# unchanged
:trun block
emit &s_copy
copy &ob &zero
copy &ol &l1
call &emitop &tru2
:tru2 block
emit &sp
copy &ob &one1
copy &ol &l2
call &emitop &trx

# is the operand (ob, ol) an address of the host: 0x and at least one hex digit, nothing else (hok)
:ishost word
copy &hok &zero
copy &mi &zero8
call &peek &ih1
:ih1 block
eq &tc &s_0 &q2
if &q2[1] &ih2 &ihend
:ih2 block
lut &inc8 &mi &mi
call &peek &ih3
:ih3 block
eq &tc &s_x &q2
if &q2[1] &ih4 &ihend
:ih4 block
lut &inc8 &mi &mi
copy &dcnt &zero8
goto &ihl
:ihl block
eq &mi &ol &q2
if &q2[1] &ihdone &ih5
:ih5 block
call &peek &ih6
:ih6 block
lut &hexv &tc &hv
if &hv[4] &ih7 &ihend
:ih7 block
lut &inc8 &mi &mi
lut &inc8 &dcnt &dcnt
goto &ihl
:ihdone block
eq &dcnt &zero8 &q2
if &q2[1] &ihend &ih8
:ih8 block
copy &hok &one1
ret
:ihend block
ret

# the character at mi of the operand (ob, ol) in tc, 0 at the end
:peek word
eq &mi &ol &q2
if &q2[1] &pk0 &pk1
:pk0 block
copy &tc &zero8
ret
:pk1 block
copy &ti[0:7] &mi[0:7]
copy &ti[7] &ob
lut &tk &ti &tc
ret

# a name from mi: nm (the characters shifted in), nlen, nok (1..14 bytes, not a digit first), mi after it
:mkname word
copy &nm &z112
copy &hh &zero12
copy &nlen &zero8
copy &nbad &zero
goto &mkl
:mkl block
eq &mi &ol &q2
if &q2[1] &mkend &mk1
:mk1 block
call &peek &mk2
:mk2 block
lut &cc &tc &tcl
if &tcl[6] &mk3 &mkend
:mk3 block
eq &nlen &zero8 &q2
if &q2[1] &mk3a &mk4
:mk3a block
if &tcl[7] &mk3b &mk4
:mk3b block
copy &nbad &one1
goto &mk4
:mk4 block
lut &is14 &nlen[0:4] &q1
if &q1 &mkov &mk5
:mkov block
copy &nbad &one1
goto &mk6
:mk5 block
copy &nt[0:104] &nm[8:112]
copy &nt[104:112] &tc
copy &nm &nt
lut &inc8 &nlen &nlen
shl &hh &hh2 3
copy &hx[0:8] &tc
add &hh2 &hx &hr
copy &hh &hr[0:12]
goto &mk6
:mk6 block
lut &inc8 &mi &mi
goto &mkl
:mkend block
copy &nok &zero
if &nbad &mke2 &mke1
:mke1 block
eq &nlen &zero8 &q2
if &q2[1] &mke2 &mke3
:mke3 block
copy &nok &one1
goto &mke2
:mke2 block
ret

# decimal digits from mi: dv (modulo 2^20), dcnt (how many), mi after them
:rddec word
copy &dv &z20
copy &dcnt &zero8
goto &rdl
:rdl block
eq &mi &ol &q2
if &q2[1] &rdend &rd1x
:rd1x block
call &peek &rd2x
:rd2x block
lut &cc &tc &tcl
if &tcl[7] &rd4x &rdend
:rd4x block
lut &hexv &tc &hv
shl &dv &nn 3
shl &dv &nn2 1
copy &wxa &nn
copy &wxb &nn2
call &wadd &rd5x
:rd5x block
copy &s21 &wxr
copy &wxa &s21[0:20]
copy &wxb &z20
copy &wxb[0:4] &hv[0:4]
call &wadd &rd6x
:rd6x block
copy &dv &wxr[0:20]
lut &inc8 &dcnt &dcnt
lut &inc8 &mi &mi
goto &rdl
:rdend block
ret

# the width of the part of space of the operand (ob, ol): wok, wv
:opwidth word
copy &wok &zero
copy &mi &zero8
call &peek &ow1
:ow1 block
eq &tc &s_amp &q2
if &q2[1] &ow2 &owend
:ow2 block
copy &mi &one8
call &mkname &ow3
:ow3 block
if &nok &ow4 &owend
:ow4 block
eq &mi &ol &q2
if &q2[1] &owwhole &owbr
:owwhole block
call &find &ow5
:ow5 block
if &fo &ow6 &owend
:ow6 block
copy &wv &fw
copy &wok &one1
ret
:owbr block
call &peek &ow7
:ow7 block
eq &tc &s_lb &q2
if &q2[1] &ow8 &owend
:ow8 block
lut &inc8 &mi &mi
call &rddec &ow9
:ow9 block
eq &dcnt &zero8 &q2
if &q2[1] &owend &ow10
:ow10 block
copy &lo &dv
call &peek &ow11
:ow11 block
eq &tc &s_rbk &q2
if &q2[1] &owone &ow12
:ow12 block
eq &tc &s_colon &q2
if &q2[1] &ow13 &owend
:ow13 block
lut &inc8 &mi &mi
call &rddec &ow14
:ow14 block
eq &dcnt &zero8 &q2
if &q2[1] &owend &ow15
:ow15 block
call &peek &ow16
:ow16 block
eq &tc &s_rbk &q2
if &q2[1] &ow17 &owend
:ow17 block
lut &inc8 &mi &mi
eq &mi &ol &q2
if &q2[1] &ow18 &owend
:ow18 block
copy &wxa &lo
copy &wxb &dv
call &wlt &ow19
:ow19 block
if &ltc[5] &ow20 &owend
:ow20 block
copy &wxa &dv
copy &wxb &lo
call &wsub &ow21
:ow21 block
copy &wv &wxr[0:20]
copy &wok &one1
ret
# &x[k]: one bit, if the bracket is the last character
:owone block
lut &inc8 &mi &mi
eq &mi &ol &q2
if &q2[1] &ow22 &owend
:ow22 block
copy &wv &c1
copy &wok &one1
ret
:owend block
ret

# the name in nm (its hash in hh) among the names of data: fo, fw. The tree gives the top cell of the hash; the names with this hash are the versions of the key
# (down by scp), the name is compared with each
:find word
copy &fo &zero
copy &ndn &one8
copy &lv &c5v
copy &wh &hh
goto &fl1
:fl1 block
copy &tx[0:2] &wh[0:2]
copy &tx[2:10] &ndn
shr &wh &wh2 2
copy &wh &wh2
lut &trn &tx &ent
lut &lz3 &lv &q1
if &q1 &fv &fl2
:fl2 block
eq &ent &zero8 &q2
if &q2[1] &fend &fl3
:fl3 block
copy &ndn &ent
lut &lvdec &lv &lv
goto &fl1
:fv block
eq &ent &zero8 &q2
if &q2[1] &fend &fv1
:fv1 block
lut &sna &ent[0:6] &ea
eq &nm[0:56] &ea &fm
if &fm[13] &fv2 &fvn
:fv2 block
lut &snb &ent[0:6] &eb
eq &nm[56:112] &eb &fn
if &fn[13] &fv3 &fvn
:fv3 block
lut &swd &ent[0:6] &fw
copy &fo &one1
ret
:fvn block
lut &scp &ent[0:6] &ptc
copy &ent[0:6] &ptc
goto &fv
:fend block
ret

# a new top cell nc for the hash hh: tok = 1 if it is kept (a node is missing: 0), ot = the cell which was the top before (0: none)
:tins word
copy &tok &zero
copy &ndn &one8
copy &lv &c5v
copy &wh &hh
goto &ti1
:ti1 block
copy &tx[0:2] &wh[0:2]
copy &tx[2:10] &ndn
shr &wh &wh2 2
copy &wh &wh2
lut &trn &tx &ent
lut &lz3 &lv &q1
if &q1 &ti2 &ti3
:ti2 block
copy &ot &ent
store &trn &tx &nc
copy &tok &one1
ret
:ti3 block
eq &ent &zero8 &q2
if &q2[1] &ti4 &ti6
:ti4 block
eq &ntp &zero8 &q2
if &q2[1] &tiend &ti5
:ti5 block
copy &ent &ntp
store &trn &tx &ent
lut &inc8 &ntp &ntp
goto &ti6
:ti6 block
copy &ndn &ent
lut &lvdec &lv &lv
goto &ti1
:tiend block
ret

# --- a long copy: the words of language 3 (hput: the host is the destination; xb, xl: the data operand; hb, hl: the address; wv: n)
:hostcopy word
emit &s_z1
copy &nlo &z20
copy &nv4 &c6
call &nibline &hc1
:hc1 block
if &hput &hc2 &hc1a
:hc1a block
copy &nlo &c28
copy &nv4 &one4
call &nibline &hc2
# the nibbles of n
:hc2 block
copy &nn &wv
copy &nlo &c44
copy &ii &zero8
goto &hcn
:hcn block
copy &nv4 &nn[0:4]
lut &nzt &nv4 &q1
if &q1 &hcn1 &hcn2
:hcn1 block
call &nibline &hcn2
:hcn2 block
shr &nn &nn2 4
copy &nn &nn2
copy &wxa &nlo
copy &wxb &c4a
call &wadd &hcn3
:hcn3 block
copy &nlo &wxr[0:20]
lut &inc8 &ii &ii
eq &ii &c5 &q2
if &q2[1] &hcp &hcn
# the nibbles of the position: at most 32 digits from the end, the digit j is at hl - 1 - j
:hcp block
copy &nlo &c76
copy &jj &zero8
copy &dpos &hl
goto &hcpl
:hcpl block
eq &jj &c32 &q2
if &q2[1] &hct &hcp1
:hcp1 block
eq &dpos &two8 &q2
if &q2[1] &hct &hcp2
:hcp2 block
sub &dpos &one8 &s9
copy &dpos &s9[0:8]
copy &ti[0:7] &dpos[0:7]
copy &ti[7] &hb
lut &tk &ti &tc
lut &hexv &tc &hv
copy &nv4 &hv[0:4]
lut &nzt &nv4 &q1
if &q1 &hcp3 &hcp4
:hcp3 block
call &nibline &hcp4
:hcp4 block
copy &wxa &nlo
copy &wxb &c4a
call &wadd &hcp5
:hcp5 block
copy &nlo &wxr[0:20]
lut &inc8 &jj &jj
goto &hcpl
:hct block
copy &wxa &c204
copy &wxb &wv
call &wadd &hct1
:hct1 block
copy &pn &wxr[0:20]
if &hput &hput1 &hget1
# put: the data into the buffer, the row to SYS
:hput1 block
emit &s_cq204
copy &pv &pn
call &putdec &hp2
:hp2 block
emit &s_rb
copy &ob &xb
copy &ol &xl
call &emitop &hp3
:hp3 block
emit &nl8
emit &s_sys1
copy &pv &pn
call &putdec &hp4
:hp4 block
emit &s_rbn
ret
# get: the request, the answer (at least 117 bits are read), the data
:hget1 block
emit &s_sys2
emit &s_cq204
copy &wxa &wv
copy &wxb &c117
call &wlt &hg2
:hg2 block
if &ltc[5] &hg3 &hg4
:hg3 block
copy &nn &c117
goto &hg5
:hg4 block
copy &nn &wv
goto &hg5
:hg5 block
copy &wxa &c204
copy &wxb &nn
call &wadd &hg6
:hg6 block
copy &pv &wxr[0:20]
call &putdec &hg7
:hg7 block
emit &s_rsys
emit &s_copy
copy &ob &xb
copy &ol &xl
call &emitop &hg8
:hg8 block
emit &s_q204
copy &pv &pn
call &putdec &hg9
:hg9 block
emit &s_rbn
ret

# `copy &l4q[nlo:nlo+4] &l4n<v / 5>[...]` for the nibble nv4
:nibline word
emit &s_cq
copy &pv &nlo
call &putdec &nb1
:nb1 block
emit &s_colon
copy &wxa &nlo
copy &wxb &c4a
call &wadd &nb2
:nb2 block
copy &pv &wxr[0:20]
call &putdec &nb3
:nb3 block
emit &s_rb
copy &ix[0:4] &zero8[0:4]
copy &ix[4:8] &nv4
goto &nbl
:nbl block
lut &nsrc &ix &tc
eq &tc &zero8 &q2
if &q2[1] &nbe &nb4
:nb4 block
emit &tc
lut &inc8 &ix &ix
goto &nbl
:nbe block
emit &nl8
ret

# pv in decimal, without leading zeros (pv < 10000)
:putdec word
copy &pi &zero8
copy &pk &zero
goto &pdp
:pdp block
lut &pl &pi[0:2] &pp
copy &dgt &zero8
goto &pdd
:pdd block
copy &wxa &pv
copy &wxb &pp
call &wlt &pd1
:pd1 block
if &ltc[5] &pde &pd2
:pd2 block
copy &wxa &pv
copy &wxb &pp
call &wsub &pd3
:pd3 block
copy &pv &wxr[0:20]
lut &inc8 &dgt &dgt
goto &pdd
:pde block
eq &dgt &zero8 &q2
if &q2[1] &pdz &pdprint
:pdz block
if &pk &pdprint &pdz2
:pdz2 block
eq &pi &c3b &q2
if &q2[1] &pdprint &pdnext
:pdprint block
lut &dch &dgt[0:4] &chd
emit &chd
copy &pk &one1
goto &pdnext
:pdnext block
lut &inc8 &pi &pi
eq &pi &c4b &q2
if &q2[1] &pdend &pdp
:pdend block
ret

:wadd word
add &wxa &wxb &wxr
ret
:wsub word
sub &wxa &wxb &wxr
ret
:wlt word
lt &wxa &wxb &ltc
ret
:weq word
eq &wxa &wxb &q5
ret
