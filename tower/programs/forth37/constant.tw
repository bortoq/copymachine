# constant: 48 constant zero 7 constant seven : main zero seven + emit ;
:zer data 8 48
:seven data 8 7
:t data 8 0
:ta8 data 9 0
:rev4 table 4 4 0 8 4 12 2 10 6 14 1 9 5 13 3 11 7 15
:eb data 8 0
:eo data 8 0
:main block
add &zer &seven &ta8
copy &t &ta8[0:8]
copy &eb &t
call &ebyte &r1
:r1 block
halt
:ebyte word
lut &rev4 &eb[4:8] &eo[0:4]
lut &rev4 &eb[0:4] &eo[4:8]
emit &eo
ret
