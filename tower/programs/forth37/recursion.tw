copy &tt &k1_8
store &rst &rsp[0:5] &tt
add &rsp &k1_8 &ta8
copy &rsp &ta8[0:8]
goto &e5
:g7 block
copy &rv &k1_8
goto &h8
:a1 block
sub &dsp &k1_8 &ts8
copy &dsp &ts8[0:8]
lut &dst &dsp[0:5] &nn
copy &ma[0:8] &nn
copy &mb[0:8] &rv
call &mul &r9
:r9 block
copy &rv &mr[0:8]
goto &h8
:h8 block
sub &rsp &k1_8 &ts8
copy &rsp &ts8[0:8]
lut &rst &rsp[0:5] &cc
eq &cc &k1_8 &te8
if &te8[1] &a1 &dp10
:dp10 block
eq &cc &k2_8 &te8
if &te8[1] &b2 &dp11
:dp11 block
eq &cc &k3_8 &te8
if &te8[1] &c3 &dp12
:dp12 block
goto &d4
:b2 block
copy &eb &rv
call &ebyte &r13
:r13 block
copy &tt &k3_8
store &rst &rsp[0:5] &tt
add &rsp &k1_8 &ta8
copy &rsp &ta8[0:8]
copy &nn &k0_8
goto &e5
:c3 block
add &rv &k48_8 &ta8
copy &v &ta8[0:8]
copy &eb &v
call &ebyte &r14
:r14 block
copy &tt &k4_8
store &rst &rsp[0:5] &tt
add &rsp &k1_8 &ta8
copy &rsp &ta8[0:8]
copy &nn &k4_8
goto &e5
:d4 block
copy &eb &rv
call &ebyte &r15
:r15 block
halt
:mul word
copy &mx &ma
copy &my &mb
copy &mr &z32
copy &mi &z8
goto &ml16
:ml16 block
if &my[0] &ma17 &mn18
:ma17 block
add &mr &mx &ta32
copy &mr &ta32[0:32]
