:mn18 block
shl &mx &mw 1
copy &mx &mw
shr &my &mw 1
copy &my &mw
add &mi &k1_8 &ta8
copy &mi &ta8[0:8]
eq &mi &k32_8 &te8
if &te8[1] &md19 &ml16
:md19 block
ret
:ebyte word
lut &rev4 &eb[4:8] &eo[0:4]
lut &rev4 &eb[0:4] &eo[4:8]
