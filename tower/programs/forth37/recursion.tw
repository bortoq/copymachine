:k48_8 data 8 48
:k4_8 data 8 4
:mx data 32 0
:my data 32 0
:mw data 32 0
:mi data 8 0
:z32 data 32 0
:z8 data 8 0
:ta32 data 33 0
:k32_8 data 8 32
:main block
copy &tt &k2_8
store &rst &rsp[0:5] &tt
add &rsp &k1_8 &ta8
