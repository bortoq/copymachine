:dp9 block
eq &cc &k2_8 &te8
if &te8[1] &e5 &dp10
:dp10 block
eq &cc &k3_8 &te8
if &te8[1] &g7 &dp11
:dp11 block
goto &h8
:g7 block
copy &eb &rv
call &ebyte &r12
:r12 block
copy &tt &k4_8
store &rst &rsp[0:5] &tt
add &rsp &k1_8 &ta8
copy &rsp &ta8[0:8]
copy &nn &k12_8
goto &a1
:h8 block
sub &rv &k100_8 &ts8
copy &rv &ts8[0:8]
copy &eb &rv
call &ebyte &r13
:r13 block
