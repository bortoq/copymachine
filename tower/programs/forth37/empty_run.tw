if &f0 &e1 &e2
:e1 block
goto &e2
:e2 block
goto &e3
:e3 block
add &x &k1_8 &ta8
copy &x &ta8[0:8]
eq &x &k3_8 &te8
if &te8[1] &e5 &e3
:e5 block
add &x &k48_8 &ta8
copy &v &ta8[0:8]
