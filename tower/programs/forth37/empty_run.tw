# empty-run: variable x : main 1 x ! 0 if then x @ drop begin x @ 1 + dup x ! 3 = until x @ 48 + emit 1 if x @ drop then 65 emit ;
:x data 8 0
:f0 data 1 0
:f1 data 1 1
:k1_8 data 8 1
:ta8 data 9 0
