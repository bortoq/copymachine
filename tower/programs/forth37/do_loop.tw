# do-loop: 5 0 do i 48 + emit loop 3 0 do 2 0 do i 48 + emit loop loop
:i data 8 0
:j data 8 0
:z8 data 8 0
:v data 8 0
:k48_8 data 8 48
:ta8 data 9 0
:rev4 table 4 4 0 8 4 12 2 10 6 14 1 9 5 13 3 11 7 15
:eb data 8 0
:eo data 8 0
:k1_8 data 8 1
:k5_8 data 8 5
:te8 data 2 0
:k2_8 data 8 2
:k3_8 data 8 3
:main block
copy &i &z8
goto &lp1
:lp1 block
add &i &k48_8 &ta8
copy &v &ta8[0:8]
copy &eb &v
call &ebyte &r2
:r2 block
add &i &k1_8 &ta8
copy &i &ta8[0:8]
eq &i &k5_8 &te8
if &te8[1] &nx3 &lp1
:nx3 block
copy &j &z8
goto &ou4
:ou4 block
copy &i &z8
goto &lp5
:lp5 block
add &i &k48_8 &ta8
copy &v &ta8[0:8]
copy &eb &v
call &ebyte &r6
:r6 block
add &i &k1_8 &ta8
copy &i &ta8[0:8]
eq &i &k2_8 &te8
if &te8[1] &nx7 &lp5
:nx7 block
add &j &k1_8 &ta8
copy &j &ta8[0:8]
eq &j &k3_8 &te8
if &te8[1] &dn8 &ou4
:dn8 block
halt
:ebyte word
lut &rev4 &eb[4:8] &eo[0:4]
lut &rev4 &eb[0:4] &eo[4:8]
emit &eo
ret
