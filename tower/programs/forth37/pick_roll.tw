:rev4 table 4 4 0 8 4 12 2 10 6 14 1 9 5 13 3 11 7 15
:eb data 8 0
:eo data 8 0
:k68_8 data 8 68
:k69_8 data 8 69
:k70_8 data 8 70
:main block
copy &s3 &k65_8
copy &s4 &k66_8
copy &s5 &k67_8
