:e1 data 1 0
:e5 data 5 0
:hc data 8 0
:pk data 7 0
:lf data 1 0
:tn data 7 0
:pi data 12 0
:pe data 56 0
:pf data 56 0
:pj data 7 0
:pc data 4 0
:f7 data 1 0
:t13 data 13 0
# the lookup
:fnd data 1 0
:li data 7 0
:l8 data 8 0
:l9 data 8 0
:e2 data 2 0
:cand data 64 0
:e16 data 16 0
:kd data 5 0
:ra data 8 0
:tp data 8 0
:uvv data 20 0
:pin17 data 17 0
:pxi data 7 0
# the tree
:cap data 20 0
:tnb data 20 0
:kk data 20 0
:npow data 20 0
:tx data 20 0
:dd7 data 7 0
:bitn data 7 0
:pn data 8 0
:pl data 8 0
# constants
:z2 data 2 0
:z3 data 3 0
:z4 data 4 0
:z7 data 7 0
:z8 data 8 0
:z10 data 10 0
:z13 data 13 0
:z20 data 20 0
:z24 data 24 0
:z32 data 32 0
:z64 data 64 0
:one1 data 1 1
:one7 data 7 1
:one20 data 20 1
:one12 data 12 1
:two20 data 20 2
:four20 data 20 4
:k1_4 data 4 1
:c0 data 2 0
:c1 data 2 1
:c2 data 2 2
:c3 data 2 3
:k_uword data 5 23
:k_uvar data 5 24
:k_uconst data 5 25
:wk1 data 3 1
:wk2 data 3 2
:wk3 data 3 3
:wk4 data 3 4
:wk5 data 3 5
:wk6 data 3 6
:md1 data 2 1
:md2 data 2 2
:md3 data 2 3
:chn data 8 "n"
:chx data 8 "x"
:chk data 8 "k"
:chw data 8 "w"
:chz data 8 "z"
:chcol data 8 ":"
:nulb data 8 0
:nmain data 64 "\0\0\0\0main"

:main block
copy &tn &t_prelude
call &etpl &m1
:m1 block
goto &read

# --- a character: the class (bits 0 blank, 1 zero byte, 2 digit, 3 minus, 4 quote, 5 right parenthesis, 6 line break)
:read block
key &ch
lut &cls &ch &cl
if &md[1] &rmd &rnm
:rnm block
if &md[0] &rpar &rnorm
:rpar block
if &cl[5] &rpar1 &rpar2
:rpar1 block
copy &md &z2
goto &read
:rpar2 block
if &cl[1] &eot &read
:rmd block
if &md[0] &rstr &rline
:rline block
if &cl[6] &rline1 &rline2
:rline1 block
copy &md &z2
goto &read
:rline2 block
if &cl[1] &eot &read
:rstr block
if &cl[1] &eot &rstr1
:rstr1 block
if &cl[4] &strend &rstr2
:rstr2 block
if &slen[5] &read &rstr3
:rstr3 block
store &sbf &slen[0:6] &ch
lut &inc7 &slen &slen
goto &read
:strend block
copy &md &z2
call &strfin &read
:rnorm block
if &cl[1] &rend &rn1
:rend block
call &tokend &eot
:rn1 block
if &cl[0] &rblank &rtc
:rblank block
call &tokend &read
:rtc block
call &tokchar &read

# --- the end of the text: the call of main, the routines, the trees, the zero byte
:eot block
call &finish &done
:done block
halt

# --- a character of a token
:tokchar word
if &tk &tc2 &tc1
:tc1 block
copy &tk &one1
copy &fst &one1
copy &isn &one1
copy &nd &zero
copy &neg &zero
copy &nv &z32
copy &nm &z64
copy &fc &ch
goto &tc2
:tc2 block
shr &nm &nt 8
copy &nm &nt
copy &nm[56:64] &ch
if &cl[2] &tcd &tc3
:tcd block
call &acc &tcd2
:tcd2 block
copy &nd &one1
goto &tcend
:tc3 block
if &cl[3] &tc4 &tc5
:tc4 block
if &fst &tc6 &tc5
:tc6 block
copy &neg &one1
goto &tcend
:tc5 block
copy &isn &zero
goto &tcend
:tcend block
copy &fst &zero
ret

# nv = nv * 10 + the digit
:acc word
lut &rev4 &ch[4:8] &dg4
shl &nv &n8 3
shl &nv &n2 1
add &n8 &n2 &s33
copy &n10 &s33[0:32]
copy &d32[0:4] &dg4
add &n10 &d32 &s33
copy &nv &s33[0:32]
ret

# --- the end of a token
:tokend word
if &tk &te1 &teret
:teret block
ret
:te1 block
copy &tk &zero
if &wf &te2 &te3
:te2 block
call &wantp &teret
:te3 block
if &isn &te4 &te6
:te4 block
if &nd &te5 &te6
:te5 block
if &neg &te5a &te5b
:te5a block
sub &z32 &nv &s33
copy &nv &s33[0:32]
goto &te5b
:te5b block
call &lit &teret
:te6 block
call &lookup &te7
:te7 block
if &fnd &te8 &teret
:te8 block
call &dispatch &teret

# --- the word of the name (the next token is a name or a character)
:wantp word
copy &wf &zero
if &want[2] &wp45 &wp03
:wp03 block
if &want[1] &wp23 &wcolon
:wp23 block
if &want[0] &wconst &wvar
:wp45 block
if &want[1] &wtick &wp4
:wp4 block
if &want[0] &wchar &wcreate
:wret block
ret
# : name
:wcolon block
call &addentry &wc2
:wc2 block
copy &cur &wcv
call &newid &wc3
:wc3 block
copy &r1 &nid
copy &cont &nid
copy &r2 &wcv
add &wcv &one20 &t21
copy &wcv &t21[0:20]
copy &tn &t_colon
call &etpl &wret
# variable name
:wvar block
copy &tp[0:1] &zero
call &addvar &wv1
:wv1 block
add &ccv &four20 &t21
copy &ccv &t21[0:20]
goto &wret
# constant name
:wconst block
copy &tp[0:1] &one1
call &addvar &wc4
:wc4 block
call &litcc &wc5
:wc5 block
copy &pxi &px_store
call &plainix &wc6
:wc6 block
add &ccv &four20 &t21
copy &ccv &t21[0:20]
goto &wret
# create name
:wcreate block
copy &tp[0:1] &one1
call &addvar &wcr1
:wcr1 block
copy &tn &t_herepush
call &etpl &wcr2
:wcr2 block
call &litcc &wcr3
:wcr3 block
copy &pxi &px_store
call &plainix &wcr4
:wcr4 block
add &ccv &four20 &t21
copy &ccv &t21[0:20]
goto &wret
# [char] c
:wchar block
copy &nv &z32
lut &rev4 &fc[0:4] &nv[4:8]
lut &rev4 &fc[4:8] &nv[0:4]
call &lit &wret
# ' name
:wtick block
call &lookup &wt1
:wt1 block
if &fnd &wt2 &wret
:wt2 block
copy &nv &z32
copy &nv[0:20] &uvv
call &lit &wret

# a new entry: the name nm, a word of the number wcv (colon) or a cell of the memory (variable, constant: uvar, uconst)
:addentry word
store &un &nu[0:7] &nm
store &uk &nu[0:7] &k_uword
store &uv &nu[0:7] &wcv
lut &inc7 &nu &nu
ret
:addvar word
store &un &nu[0:7] &nm
store &uk &nu[0:7] &k_uvar
store &uv &nu[0:7] &ccv
if &tp[0] &avc &avv
:avc block
store &uk &nu[0:7] &k_uconst
goto &avv
:avv block
lut &inc7 &nu &nu
ret

# nv = the cell address ccv, then the literal
:litcc word
copy &nv &z32
copy &nv[0:20] &ccv
call &lit &lcret
:lcret block
ret

# --- the lookup of the name nm: user words (the last first), then the words of forth.def
:lookup word
copy &fnd &zero
copy &li &nu
goto &lk1
:lk1 block
copy &l8[0:7] &li
eq &l8 &z8 &e2
if &e2[1] &lkp &lk2
:lk2 block
lut &dec7 &li &li
lut &un &li &cand
eq &nm &cand &e16
if &e16[15] &lku &lk1
:lku block
lut &uk &li &kd
lut &uv &li &uvv
copy &fnd &one1
ret
:lkp block
copy &li &z7
goto &lkp1
:lkp1 block
copy &l8[0:7] &li
copy &l9[0:7] &npr
eq &l8 &l9 &e2
if &e2[1] &lkend &lkp2
:lkp2 block
lut &pnm &li &cand
eq &nm &cand &e16
if &e16[15] &lkpf &lkp3
:lkp3 block
lut &inc7 &li &li
goto &lkp1
:lkpf block
lut &pin &li &pin17
call &dec17 &lkp4
:lkp4 block
copy &fnd &one1
goto &lkend
:lkend block
ret

# kd, ra, tp from pin17
:dec17 word
copy &kd &pin17[0:5]
copy &ra[0:5] &pin17[5:10]
copy &ra[5:8] &z3
copy &tp[0:7] &pin17[10:17]
copy &tp[7:8] &zero
ret

# the word number pxi of forth.def, as the word in the text
:plainix word
lut &pin &pxi &pin17
call &dec17 &pix1
:pix1 block
call &plain &pix2
:pix2 block
ret

# a word of kind plain: the call of its routine (once written at the end), then its template
:plain word
eq &ra &z8 &e2
if &e2[1] &pl2 &pl1
:pl1 block
store &used &ra[0:7] &one1
call &newid &pl1a
:pl1a block
copy &r1 &nid
copy &r3[0:8] &ra
copy &r3[8:20] &z24[0:12]
copy &tn &t_rcall
call &etpl &pl2
:pl2 block
eq &tp &z8 &e2
if &e2[1] &plret &pl3
:pl3 block
copy &tn[0:7] &tp[0:7]
call &etpl &plret
:plret block
ret

# a call of the user word uvv (template tn)
:ucall word
call &newid &uc1
:uc1 block
copy &r1 &nid
copy &r2 &scv
copy &r3 &uvv
add &scv &one20 &t21
copy &scv &t21[0:20]
call &etpl &ucret
:ucret block
ret

# the identifier: nid = idv, idv + 1
:newid word
copy &nid &idv
add &idv &one20 &t21
copy &idv &t21[0:20]
ret

# the control stack
:cpush word
store &ctl &cp &cv
lut &inc7 &cp &cp
ret
:cpop word
lut &dec7 &cp &cp
lut &ctl &cp &cv
ret

# the literal nv: the number r2 (20 bits) and r3 (the other 12 bits)
:lit word
call &newid &li1
:li1 block
copy &r1 &nid
copy &r2 &nv[0:20]
copy &r3[0:12] &nv[20:32]
copy &r3[12:20] &z8
eq &r3 &z20 &e5
if &e5[4] &li2 &li3
:li2 block
copy &tn &t_lit
call &etpl &li4
:li3 block
copy &tn &t_lith
call &etpl &li4
:li4 block
ret

# --- the decimal number pv
:pdec word
copy &st &zero
copy &pk &z7
goto &pd1
:pd1 block
lut &pw &pk[0:3] &pq
copy &dd &z4
goto &pd3
:pd3 block
lt &pv &pq &l6
if &l6[5] &pd5 &pd4
:pd4 block
sub &pv &pq &t21
copy &pv &t21[0:20]
add &dd &k1_4 &t5
copy &dd &t5[0:4]
goto &pd3
:pd5 block
eq &dd &z4 &e1
if &e1 &pd6 &pd7
:pd6 block
if &st &pd8 &pd9
:pd7 block
copy &st &one1
goto &pd8
:pd8 block
lut &hex4 &dd &hc
emit &hc
goto &pd9
:pd9 block
lut &last6 &pk[0:3] &lf
if &lf &pd10 &pd11
:pd11 block
lut &inc7 &pk &pk
goto &pd1
:pd10 block
if &st &pd12 &pd13
:pd13 block
lut &hex4 &dd &hc
emit &hc
goto &pd12
:pd12 block
ret

# --- the template tn: the characters of the pool up to the zero byte; @ ~ % ^ are r1..r4
:etpl word
store &rg &c0 &r1
store &rg &c1 &r2
store &rg &c2 &r3
store &rg &c3 &r4
lut &tst &tn &pi
copy &pj &z7
goto &et1
:et1 block
if &pi[10] &et2 &et3
:et2 block
lut &pool1 &pi[0:9] &pe
goto &et4
:et3 block
lut &pool0 &pi[0:10] &pe
goto &et4
:et4 block
copy &ch &pe[0:8]
shr &pe &pf 8
copy &pe &pf
lut &pcl &ch &pc
if &pc[3] &et5 &et6
:et5 block
lut &rg &pc[0:2] &pv
call &pdec &et9
:et6 block
if &pc[2] &etend &et8
:et8 block
emit &ch
goto &et9
:et9 block
lut &inc7 &pj &pj
lut &is7 &pj[0:3] &f7
if &f7 &et10 &et4
:et10 block
add &pi &one12 &t13
copy &pi &t13[0:12]
copy &pj &z7
goto &et1
:etend block
ret

# --- the kind of the word: kd (a tree of `if` on its bits), the handlers
:dispatch word
goto &dk1
# --- tree
:dk1 block
if &kd[4] &dk3 &dk2
:dk2 block
if &kd[3] &dk5 &dk4
:dk3 block
if &kd[3] &dk7 &dk6
:dk4 block
if &kd[2] &dk9 &dk8
:dk5 block
if &kd[2] &dk11 &dk10
:dk6 block
if &kd[2] &dk13 &dk12
:dk7 block
if &kd[2] &dk15 &dk14
:dk8 block
if &kd[1] &dk17 &dk16
:dk9 block
if &kd[1] &dk19 &dk18
:dk10 block
if &kd[1] &dk21 &dk20
:dk11 block
if &kd[1] &dk23 &dk22
:dk12 block
if &kd[1] &dk25 &dk24
:dk13 block
if &kd[1] &dk27 &dk26
:dk14 block
if &kd[1] &dk29 &dk28
:dk15 block
if &kd[1] &dk31 &dk30
:dk16 block
if &kd[0] &hk_colon &hk_plain
:dk17 block
if &kd[0] &hk_if &hk_semi
:dk18 block
if &kd[0] &hk_then &hk_else
:dk19 block
if &kd[0] &hk_until &hk_begin
:dk20 block
if &kd[0] &hk_do &hk_repeat
:dk21 block
if &kd[0] &hk_leave &hk_loop
:dk22 block
if &kd[0] &hk_recurse &hk_exit
:dk23 block
if &kd[0] &hk_constant &hk_variable
:dk24 block
if &kd[0] &hk_paren &hk_create
:dk25 block
if &kd[0] &hk_squote &hk_bslash
:dk26 block
if &kd[0] &hk_tick &hk_bchar
:dk27 block
if &kd[0] &hk_uword &hk_macro
:dk28 block
if &kd[0] &hk_uconst &hk_uvar
:dk29 block
if &kd[0] &hkret &hk_execute
:dk30 block
if &kd[0] &hkret &hkret
:dk31 block
if &kd[0] &hkret &hkret
# --- handlers
:hkret block
ret
:hk_plain block
call &plain &hkret
:hk_colon block
copy &want &wk1
copy &wf &one1
goto &hkret
:hk_semi block
copy &r1 &cont
copy &tn &t_ret
call &etpl &hkret
:hk_if block
call &newid &hi1
:hi1 block
copy &r1 &nid
call &newid &hi2
:hi2 block
copy &r2 &nid
copy &cv &nid
call &cpush &hi3
:hi3 block
copy &tn[0:7] &tp[0:7]
call &etpl &hkret
:hk_else block
call &newid &he1
:he1 block
copy &r1 &nid
call &cpop &he2
:he2 block
copy &r2 &cv
copy &cv &r1
call &cpush &he3
:he3 block
copy &tn[0:7] &tp[0:7]
call &etpl &hkret
:hk_then block
call &cpop &ht1
:ht1 block
copy &r1 &cv
copy &r2 &cv
copy &tn[0:7] &tp[0:7]
call &etpl &hkret
:hk_begin block
call &newid &hb1
:hb1 block
copy &r1 &nid
copy &r2 &nid
copy &cv &nid
call &cpush &hb2
:hb2 block
copy &tn[0:7] &tp[0:7]
call &etpl &hkret
:hk_until block
call &cpop &hu1
:hu1 block
copy &r1 &cv
call &newid &hu2
:hu2 block
copy &r2 &nid
copy &tn[0:7] &tp[0:7]
call &etpl &hkret
:hk_repeat block
call &cpop &hr1
:hr1 block
copy &r2 &cv
call &cpop &hr2
:hr2 block
copy &r1 &cv
copy &tn[0:7] &tp[0:7]
call &etpl &hkret
:hk_do block
call &newid &hd1
:hd1 block
copy &r1 &nid
call &newid &hd2
:hd2 block
copy &r2 &nid
call &newid &hd3
:hd3 block
copy &r3 &nid
call &newid &hd4
:hd4 block
copy &r4 &nid
store &lt1 &lq &r1
store &lt2 &lq &r2
store &lt3 &lq &r3
lut &inc7 &lq &lq
copy &tn[0:7] &tp[0:7]
call &etpl &hkret
:hk_loop block
lut &dec7 &lq &lq
lut &lt1 &lq &r1
lut &lt2 &lq &r2
lut &lt3 &lq &r3
copy &tn[0:7] &tp[0:7]
call &etpl &hkret
:hk_leave block
lut &dec7 &lq &li
lut &lt2 &li &r1
call &newid &hl1
:hl1 block
copy &r2 &nid
copy &tn[0:7] &tp[0:7]
call &etpl &hkret
:hk_exit block
call &newid &hx1
:hx1 block
copy &r1 &nid
copy &tn[0:7] &tp[0:7]
call &etpl &hkret
:hk_recurse block
copy &uvv &cur
goto &hk_uword
:hk_variable block
copy &want &wk2
copy &wf &one1
goto &hkret
:hk_constant block
copy &want &wk3
copy &wf &one1
goto &hkret
:hk_create block
copy &want &wk4
copy &wf &one1
goto &hkret
:hk_paren block
copy &md &md1
goto &hkret
:hk_bslash block
copy &md &md2
goto &hkret
:hk_squote block
copy &md &md3
copy &slen &z7
goto &hkret
:hk_bchar block
copy &want &wk5
copy &wf &one1
goto &hkret
:hk_tick block
copy &want &wk6
copy &wf &one1
goto &hkret
:hk_macro block
copy &pxi &tp[0:7]
copy &nv &z32
copy &nv[0:8] &ra
call &lit &hm1
:hm1 block
call &plainix &hkret
:hk_uword block
copy &tn &t_call
call &ucall &hkret
:hk_uvar block
copy &nv &z32
copy &nv[0:20] &uvv
call &lit &hkret
:hk_uconst block
copy &nv &z32
copy &nv[0:20] &uvv
call &lit &hu3
:hu3 block
copy &pxi &px_fetch
call &plainix &hkret
:hk_execute block
copy &xu &one1
copy &tn &t_callx
call &ucall &hkret

# --- the string s" ...": the characters in sbf (slen of them), the code that writes them into the memory
:strfin word
call &newid &sf1
:sf1 block
copy &sid &nid
copy &l8[0:7] &slen
eq &l8 &z8 &e2
if &e2[1] &sf9 &sf2
:sf2 block
copy &r1 &sid
copy &r2[0:3] &z3
copy &r2[3:10] &slen
copy &r2[10:20] &z10
copy &r3 &ccv
copy &tn &t_str1
call &etpl &sf3
:sf3 block
copy &si &z7
goto &sf4
:sf4 block
lut &sbf &si[0:6] &ch
emit &ch
lut &inc7 &si &si
copy &l8[0:7] &si
copy &l9[0:7] &slen
eq &l8 &l9 &e2
if &e2[1] &sf5 &sf4
:sf5 block
copy &tn &t_str2
call &etpl &sf6
:sf6 block
copy &si &z7
goto &sf7
:sf7 block
copy &r1 &sid
copy &r2[0:3] &z3
copy &r2[3:10] &si
copy &r2[10:20] &z10
lut &inc7 &si &si
copy &r3[0:3] &z3
copy &r3[3:10] &si
copy &r3[10:20] &z10
copy &tn &t_strch
call &etpl &sf8
:sf8 block
copy &l8[0:7] &si
copy &l9[0:7] &slen
eq &l8 &l9 &e2
if &e2[1] &sf9 &sf7
:sf9 block
call &litcc &sf10
:sf10 block
copy &nv &z32
copy &nv[0:7] &slen
call &lit &sf11
:sf11 block
copy &r1[0:7] &slen
copy &r1[7:20] &z13
add &ccv &r1 &t21
copy &ccv &t21[0:20]
ret

# --- the end: main, the routines, the trees
:finish word
copy &nm &nmain
call &lookup &fi1
:fi1 block
if &fnd &fi2 &fi3
:fi2 block
copy &tn &t_call
call &ucall &fi3
:fi3 block
copy &tn &t_fin
call &etpl &fi4
:fi4 block
copy &rr &one7
goto &fi5
:fi5 block
lut &used &rr &lf
if &lf &fi6 &fi8
:fi6 block
copy &r1[0:7] &rr
copy &r1[7:20] &z13
lut &rtt &rr &tn
call &etpl &fi8
:fi8 block
copy &l8[0:7] &rr
copy &l9[0:7] &nrt
eq &l8 &l9 &e2
if &e2[1] &fi10 &fi9
:fi9 block
lut &inc7 &rr &rr
goto &fi5
:fi10 block
copy &tn &t_rthead
call &etpl &fi11
:fi11 block
copy &pn &chn
copy &pl &chk
copy &tnb &scv
call &tree &fi12
:fi12 block
copy &tn &t_kz
call &etpl &fi13
:fi13 block
if &xu &fi14 &fi16
:fi14 block
copy &tn &t_exhead
call &etpl &fi15
:fi15 block
copy &pn &chx
copy &pl &chw
copy &tnb &wcv
call &tree &fi16
:fi16 block
emit &nulb
ret

# a tree of `if` on the bits of rc: the nodes pn1.. (heap numbers), the leaves pl0 .. pl(tnb-1), `kz` beyond
:tree word
copy &cap &two20
copy &dd7 &one7
goto &tr1
:tr1 block
lt &cap &tnb &l6
if &l6[5] &tr2 &tr3
:tr2 block
add &cap &cap &t21
copy &cap &t21[0:20]
lut &inc7 &dd7 &dd7
goto &tr1
:tr3 block
lut &dec7 &dd7 &bitn
copy &kk &one20
copy &npow &two20
goto &tr4
:tr4 block
emit &chcol
emit &pn
copy &pv &kk
call &pdec &tr5
:tr5 block
copy &tn &t_tn1
call &etpl &tr6
:tr6 block
copy &pv[0:7] &bitn
copy &pv[7:20] &z13
call &pdec &tr7
:tr7 block
copy &tn &t_tn2
call &etpl &tr8
:tr8 block
add &kk &kk &t21
copy &t0 &t21[0:20]
add &t0 &one20 &t21
copy &tx &t21[0:20]
call &ptgt &tr9
:tr9 block
copy &tn &t_tn3
call &etpl &tr10
:tr10 block
copy &tx &t0
call &ptgt &tr11
:tr11 block
copy &tn &t_tn4
call &etpl &tr12
:tr12 block
add &kk &one20 &t21
copy &kk &t21[0:20]
eq &kk &cap &e5
if &e5[4] &tr15 &tr13
:tr13 block
eq &kk &npow &e5
if &e5[4] &tr14 &tr4
:tr14 block
lut &dec7 &bitn &bitn
add &npow &npow &t21
copy &npow &t21[0:20]
goto &tr4
:tr15 block
ret

# the name of the heap number tx: a node, a leaf or kz
:ptgt word
lt &tx &cap &l6
if &l6[5] &pg1 &pg2
:pg1 block
emit &pn
copy &pv &tx
call &pdec &pg9
:pg2 block
sub &tx &cap &t21
copy &tx &t21[0:20]
lt &tx &tnb &l6
if &l6[5] &pg3 &pg4
:pg3 block
emit &pl
copy &pv &tx
call &pdec &pg9
:pg4 block
emit &chk
emit &chz
goto &pg9
:pg9 block
ret
