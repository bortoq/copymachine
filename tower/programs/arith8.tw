# Reads a and b (8 bits each) from stdin; prints a-b (8 bits), the borrow, a==b, a<<1, a>>1,
# a<<3, a>>5, all in hex (progs.arith(8, 3, 5)). eq leaves "equal" in the last bit of e.
:a data 8 0
:b data 8 0
:d data 9 0
:e data 2 0
:f1 data 4 0
:f2 data 4 0
:s0 data 8 0
:s1 data 8 0
:s2 data 8 0
:s3 data 8 0
:main block
key &a[0:8]
key &b[0:8]
sub &a &b &d
eq &a &b &e
shl &a &s0 1
shr &a &s1 1
shl &a &s2 3
shr &a &s3 5
copy &f1[0:1] &d[8]
copy &f2[0:1] &e[1]
:d_1 data 8 0
lut &hex4 &d[4:8] &d_1
emit &d_1
:d_0 data 8 0
lut &hex4 &d[0:4] &d_0
emit &d_0
:f1_0 data 8 0
lut &hex4 &f1[0:4] &f1_0
emit &f1_0
:f2_0 data 8 0
lut &hex4 &f2[0:4] &f2_0
emit &f2_0
:s0_1 data 8 0
lut &hex4 &s0[4:8] &s0_1
emit &s0_1
:s0_0 data 8 0
lut &hex4 &s0[0:4] &s0_0
emit &s0_0
:s1_1 data 8 0
lut &hex4 &s1[4:8] &s1_1
emit &s1_1
:s1_0 data 8 0
lut &hex4 &s1[0:4] &s1_0
emit &s1_0
:s2_1 data 8 0
lut &hex4 &s2[4:8] &s2_1
emit &s2_1
:s2_0 data 8 0
lut &hex4 &s2[0:4] &s2_0
emit &s2_0
:s3_1 data 8 0
lut &hex4 &s3[4:8] &s3_1
emit &s3_1
:s3_0 data 8 0
lut &hex4 &s3[0:4] &s3_0
emit &s3_0
halt
