=words
// word kind routine template
+ plain add -
- plain sub -
and plain and -
or plain or -
xor plain xor -
= plain eq -
< plain lt -
u< plain ult -
lshift plain lshift -
rshift plain rshift -
* plain mul -
/ plain divmod pushq
mod plain divmod pushm
/mod plain divmod pushmq
@ plain fetch -
! plain store -
c@ plain cfetch -
c! plain cstore -
pick plain pick -
roll plain roll -
dup plain - dup
drop plain - drop
swap plain - swap
over plain - over
rot plain - rot
>r plain - tor
r> plain - rfrom
r@ plain - rat
i plain - rat
j plain - jj
unloop plain - unloop
emit plain - emit
allot plain - allot
decimal plain - -
1+ macro 1 +
1- macro 1 -
2* macro 1 lshift
cell+ macro 4 +
cells macro 4 *
0= macro 0 =
: colon - colon
; semi - ret
if if - if
while if - if
else else - else
then then - else
begin begin - else
until until - until
repeat repeat - else
do do - do
?do do - qdo
loop loop - loop
leave leave - else
exit exit - ret
recurse recurse - call
variable variable - -
constant constant - -
create create - -
( paren - -
\ bslash - -
s" squote - -
[char] bchar - -
' tick - -
['] tick - -
execute execute - callx
