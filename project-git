#!/bin/sh
# Use alternate metadata because the environment owns the read-only .git.
project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -d "$project_root/.project-git" ]; then
    exec git -C "$project_root" --git-dir="$project_root/.project-git" --work-tree="$project_root" "$@"
fi
# A normal clone has standard .git metadata.
exec git -C "$project_root" "$@"
