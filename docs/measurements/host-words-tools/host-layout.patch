--- a/language/tools/host_layout.py	1970-01-01 02:00:00.000000000 +0200
+++ b/language/tools/host_layout.py	2026-11-03 15:27:56.850194206 +0200
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+"""18.19: the layout of the space of the emulator for the definitions on the host is written in the language
+(src/hostlayout.fth: constants hl-...). At the build this tool executes that text on the host pForth, with CONSTANT
+made to print the constant as a C macro, and writes the table of the emulator (emulator/src/host_layout.h): the
+emulator is built from it, and the definitions on the host read and write only the positions of the table.
+Usage: host_layout.py [-o FILE]   (default: stdout)"""
+import argparse
+import sys
+
+import host
+import paths
+
+# The same CONSTANT as before, after the name and the value are printed: #define HL_NAME value.
+EMIT = r"""
+: hl-type-name ( addr u -- ) 0 ?do dup i + c@ dup 45 = if drop 95 else dup 96 > over 123 < and if 32 - then then emit loop drop ;
+: hl-number ( n -- ) dup 10 / ?dup if recurse then 10 mod 48 + emit ;
+: hl-constant ( n "name" -- ) constant ;
+: constant ( n "name" -- )
+  >in @ bl word count ." #define " hl-type-name ."  " >in !
+  dup hl-number cr
+  hl-constant ;
+"""
+HEADER = ('/* generated from language/src/hostlayout.fth by language/tools/host_layout.py; do not edit.\n'
+          ' * The layout of the space of the emulator for the definitions on the host: laid by the language. */\n'
+          '#ifndef HOST_LAYOUT_H_\n#define HOST_LAYOUT_H_\n')
+
+
+def generate():
+    """The text of the header (the host pForth executes the table)."""
+    data = EMIT.encode('latin-1') + paths.source_bytes(['hostlayout.fth']) + b'\nbye\n'
+    code, out, err = host.run(host.build(), data, 600)
+    if code or err:
+        sys.exit(f'host_layout: pForth failed: code {code}, {err[-300:]!r}')
+    return HEADER + out.decode('latin-1') + '#endif\n'
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('-o', '--output')
+    args = parser.parse_args()
+    header = generate()
+    if args.output:
+        open(args.output, 'w').write(header)
+    else:
+        sys.stdout.write(header)
