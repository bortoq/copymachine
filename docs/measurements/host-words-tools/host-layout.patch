diff -ruN a/emulator/src/sys_ctrl.c b/emulator/src/sys_ctrl.c
--- a/emulator/src/sys_ctrl.c	2026-11-03 15:27:18.008778798 +0200
+++ b/emulator/src/sys_ctrl.c	2026-11-03 15:27:56.846194060 +0200
@@ -17,6 +17,7 @@
  */
 #include "sys_ctrl.h"
 #include "proto_gen.h"
+#include "host_layout.h"
 #include <errno.h>
 #include <fcntl.h>
 #include <unistd.h>
@@ -318,6 +319,276 @@
 }
 
 /*
+ * The definitions on the host (18.13, 18.15, 18.16; 18.19: the layout is laid by the language).
+ * The emulator has a space of its own, the array hv (bits, the same order as the program space: numeric fields
+ * least significant bit first), and it is a remote space of the long copy (15.2): the number HL_SPACE. The
+ * language lays it out (language/src/hostlayout.fth, executed at the build by tools/host_layout.py, which
+ * writes host_layout.h): the "processor" of the host (the cell of 32 bits at HL_PROC; the other places of the table
+ * are bits from it), the places of the arguments of every definition, the cells in which a call gives the positions
+ * of the program for the results (HL_IMG, HL_RET) and the area of the image (HL_OUT). The code of the definitions
+ * below is C of the host; it reads and writes only the positions of that table.
+ * A call is one long copy to the space HL_SPACE: it writes the block of the call (the number of the definition
+ * and the arguments) into hv. The emulator then looks at the processor (after every copy into hv, the only way
+ * its cell changes): a number there is a call; it takes the number (clears the cell), runs the definition over
+ * the arguments in their places, and copies the results
+ * to the program positions the call gave (the image, as many bits as the definition made, from the area HL_OUT;
+ * the 32-bit return value). The definitions never touch the program space and do not know where its data lie.
+ * The results are in the program space from the next tick (the rule of the answer of SYS).
+ * The format the definitions are set to: a cell of the program memory is 32 bits (numeric) at the start of a
+ * slot of 64 bits, a byte of the memory is 8 bits at 64 * (a / 4) + 8 * (a % 4) bits over the start of the memory.
+ * A definition may give a displacement (disp bits, added to the position of the image): the position inside a
+ * slot of 64 bits that it knows from its arguments (fill of an unaligned address).
+ */
+#define HV_BITS ((size)HL_OUT + HL_OUT_BITS)
+static unsigned char hv[HV_BITS / 8];
+_Static_assert(HL_PROC % 8 == 0 && HL_RET % 8 == 0 && HL_IMG % 8 == 0 && HL_IN <= HL_OUT && HL_OUT % 8 == 0 &&
+               HL_PROC + HL_ARGS <= HL_IN && HL_PROC + HL_CLASH_END <= HL_IN && HL_PROC + HL_ENC_END <= HL_IN &&
+               HL_PROC + HL_MV_END <= HL_IN, "host layout");
+static unsigned char hv_rev[256];   /* the byte with its bits reversed: the bytes of numeric fields */
+static void hv_init(void)
+{
+  unsigned b, k;
+  for(b = 0; b < 256; ++b)
+  {
+    unsigned r = 0;
+    for(k = 0; k < 8; ++k) r |= ((b >> k) & 1u) << (7 - k);
+    hv_rev[b] = (unsigned char)r;
+  }
+}
+/* the 32-bit numeric field at the bit at (a multiple of 8) of hv */
+static unsigned hv_get32(size at)
+{
+  const unsigned char *p = hv + at / 8;
+  return (unsigned)hv_rev[p[0]] | (unsigned)hv_rev[p[1]] << 8 | (unsigned)hv_rev[p[2]] << 16 | (unsigned)hv_rev[p[3]] << 24;
+}
+/* the cell at the place rel of the block of a call (the places of host_layout.h are bits from HL_PROC) */
+static unsigned hv_cell(size rel)
+{
+  return hv_get32((size)HL_PROC + rel);
+}
+typedef int (*host_def)(size *out, size *ret, size *disp);
+/* HL_CLASH_N, clashes ( size, new row, layer record ): the size at HL_CLASH_SIZE; the cells (numeric 32 bits, one in
+ * each 64 bits) of the new row (dl dh sl sh) from HL_CLASH_ROW; the cells of a record of a layer from HL_CLASH_LAYER:
+ * the cell, the next, the count n (cell 2), and from the cell 3 the rows (four cells each) of the layer. The return
+ * value is -1 or 0: some interval of the new row and some interval of one of the n rows are both non-empty, overlap
+ * and have their lower ends below size. */
+static int hd_clashes(size *out, size *ret, size *disp)
+{
+  unsigned size_, a[4], n, i, j, k;
+  (void)disp;
+  n = hv_cell(HL_CLASH_LAYER + 2 * 64);
+  if(n > 7) return EINVAL;
+  size_ = hv_cell(HL_CLASH_SIZE);
+  for(j = 0; j < 4; ++j) a[j] = hv_cell(HL_CLASH_ROW + 64 * (size)j);
+  *out = 0; *ret = 0;
+  for(k = 0; k < n; ++k)
+  {
+    unsigned b[4];
+    for(i = 0; i < 4; ++i) b[i] = hv_cell(HL_CLASH_LAYER + 64 * (3 + 4 * (size)k + i));
+    for(j = 0; j < 2; ++j)
+      for(i = 0; i < 2; ++i)
+      {
+        unsigned l1 = a[2 * j], h1 = a[2 * j + 1], l2 = b[2 * i], h2 = b[2 * i + 1];
+        if(l1 < h1 && l2 < h2 && l1 < h2 && l2 < h1 && l1 < size_ && l2 < size_) { *ret = 0xffffffffu; return 0; }
+      }
+  }
+  return 0;
+}
+/* HL_FILL_N, fill ( u, c, alo ): u at HL_FILL_U, c at HL_FILL_C, the two low bits r of the address at HL_FILL_R.
+ * The output image is the u bytes of the memory from the byte at the address, as they lie in the memory (a byte c,
+ * the 32 padding bits of each slot zero), the displacement 8 r (the position of the call is the start of the slot
+ * of the address); the return value is 0. */
+static int hd_fill(size *out, size *ret, size *disp)
+{
+  size u, r, k;
+  unsigned char rc;
+  unsigned char *img = hv + HL_OUT / 8;
+  u = hv_cell(HL_FILL_U); rc = hv_rev[hv_cell(HL_FILL_C) & 255u]; r = hv_cell(HL_FILL_R) & 3u;
+  *out = 0; *ret = 0; *disp = 8 * r;
+  if(!u) return 0;
+  if(64 * ((r + u - 1) / 4) + 8 * ((r + u - 1) % 4) + 8 - 8 * r > HL_OUT_BITS) return EINVAL;
+  *out = 64 * ((r + u - 1) / 4) + 8 * ((r + u - 1) % 4) + 8 - 8 * r;
+  memset(img, 0, (size_t)((*out + 7) / 8));
+  k = 0;
+  while(k < u && (r + k) % 4) { img[8 * ((r + k) / 4) + (r + k) % 4 - r] = rc; ++k; }
+  for(; k + 4 <= u; k += 4)
+  {
+    unsigned char *p = img + 8 * ((r + k) / 4) - r;
+    p[0] = p[1] = p[2] = p[3] = rc;
+  }
+  for(; k < u; ++k) img[8 * ((r + k) / 4) + (r + k) % 4 - r] = rc;
+  return 0;
+}
+/* HL_ENC_N, encode ( a, slots, count, rows ): a at HL_ENC_A, slots at HL_ENC_SLOTS, count at HL_ENC_COUNT, the cells
+ * of the rows (4 cells each) from HL_ENC_ROWS. The output image: the layer of slots rows of four a-bit fields
+ * (numeric bytes), the rows after count zero, in the cells of memory (4 bytes in each 64 bits). The return value is
+ * 0, or -24 if a field does not fit in a bits (a < 32). */
+static int hd_encode(size *out, size *ret, size *disp)
+{
+  size a, slots, count, nbytes, lbytes, j, i, b;
+  unsigned char *img = hv + HL_OUT / 8;
+  (void)disp;
+  a = hv_cell(HL_ENC_A); slots = hv_cell(HL_ENC_SLOTS); count = hv_cell(HL_ENC_COUNT);
+  if(a % 8 || !a || a > 64 || !slots || slots > 8 || count > slots) return EINVAL;
+  nbytes = a / 8;
+  lbytes = slots * 4 * nbytes;
+  if(lbytes % 4 || 16 * lbytes > HL_OUT_BITS) return EINVAL;
+  memset(img, 0, (size_t)(16 * lbytes / 8));
+  *out = 16 * lbytes; *ret = 0;
+  for(j = 0; j < count; ++j)
+    for(i = 0; i < 4; ++i)
+    {
+      size v = hv_cell(HL_ENC_ROWS + 64 * (4 * j + i));
+      if(a < 32 && (v >> a)) { *out = 0; *ret = 0xffffffe8u; return 0; }
+      if(a == 32) { memcpy(img + 8 * (4 * j + i), hv + (HL_PROC + HL_ENC_ROWS + 64 * (4 * j + i)) / 8, 4); continue; }  /* the same bytes: numeric both */
+      for(b = 0; b < nbytes; ++b)
+      {
+        size at = (4 * j + i) * nbytes + b;      /* the byte of the buffer */
+        img[(64 * (at / 4) + 8 * (at % 4)) / 8] = hv_rev[b < 4 ? (v >> (8 * b)) & 255u : 0];
+      }
+    }
+  return 0;
+}
+/* HL_ADD_N .. HL_ULT_N, the binary words + - and or xor = < u< ( a b -- r ): a at HL_BIN_A, b at HL_BIN_B (32 bits,
+ * numeric); no image; the return value is the result (the flags are -1 and 0, as in the words). */
+#define HD_BIN(name, expr) \
+  static int name(size *out, size *ret, size *disp) \
+  { \
+    unsigned a, b; \
+    (void)disp; \
+    a = hv_cell(HL_BIN_A); b = hv_cell(HL_BIN_B); \
+    *out = 0; *ret = (unsigned)(expr); \
+    return 0; \
+  }
+HD_BIN(hd_add, a + b)
+HD_BIN(hd_sub, a - b)
+HD_BIN(hd_and, a & b)
+HD_BIN(hd_or, a | b)
+HD_BIN(hd_xor, a ^ b)
+HD_BIN(hd_eq, a == b ? 0xffffffffu : 0u)
+HD_BIN(hd_lt, (int)a < (int)b ? 0xffffffffu : 0u)
+HD_BIN(hd_ult, a < b ? 0xffffffffu : 0u)
+/* HL_PUT_N, HL_CMOVE_N, HL_NUM_N: the bytes of the memory of the program (4 bytes in the first 32 bits of each slot
+ * of 64 bits). The arguments of put (the sink of the kernel) and cmove: the length n at HL_MV_N, the two low bits rs
+ * of the address of the source at HL_MV_RS, rd of the destination at HL_MV_RD, and from HL_MV_SRC the MV_SLOTS slots
+ * of the source from the slot of its address (the bytes rs .. rs + n - 1 of them, n <= 128). Put: the image is the n
+ * bytes themselves (bit for bit), contiguous: the position of the call is any bit address. Cmove: the image is the
+ * n bytes as they lie in the memory from the byte rd of the slot of the destination (the padding bits zero),
+ * displacement 8 rd (as fill). Numeric: the value at HL_NUM_V, the number of bytes nb <= 8 at HL_NUM_NB, rd at
+ * HL_NUM_RD: the image is the bytes of the value (numeric, the byte c of the memory is the bits of c, the least
+ * significant first), nb bytes, the higher than the fourth are zero, laid as cmove. */
+#define MV_SLOTS 33u
+#define MV_COPY_MAX 128u
+_Static_assert(HL_MV_END - HL_MV_SRC == 64 * MV_SLOTS && (HL_PROC + HL_MV_SRC) % 8 == 0, "host layout: the slots of the source");
+static size span_bits(size r, size n)   /* from the first of n bytes to the end of the last, the first at byte r of a slot */
+{
+  return n ? 64 * ((r + n - 1) / 4) + 8 * ((r + n - 1) % 4) + 8 - 8 * r : 0;
+}
+static unsigned char src_byte(size rs, size k)
+{
+  return hv[(HL_PROC + HL_MV_SRC) / 8 + 8 * ((rs + k) / 4) + (rs + k) % 4];
+}
+static int hd_put(size *out, size *ret, size *disp)
+{
+  size n, rs, k;
+  unsigned char *img = hv + HL_OUT / 8;
+  (void)disp;
+  n = hv_cell(HL_MV_N); rs = hv_cell(HL_MV_RS) & 3u;
+  if(n > MV_COPY_MAX) return EINVAL;
+  for(k = 0; k < n; ++k) img[k] = src_byte(rs, k);
+  *out = 8 * n; *ret = 0;
+  return 0;
+}
+static int hd_cmove(size *out, size *ret, size *disp)
+{
+  size n, rs, rd, k;
+  unsigned char *img = hv + HL_OUT / 8;
+  n = hv_cell(HL_MV_N); rs = hv_cell(HL_MV_RS) & 3u; rd = hv_cell(HL_MV_RD) & 3u;
+  if(n > MV_COPY_MAX) return EINVAL;
+  *out = span_bits(rd, n); *ret = 0; *disp = 8 * rd;
+  memset(img, 0, (size_t)((*out + 7) / 8));
+  for(k = 0; k < n; ++k) img[8 * ((rd + k) / 4) + (rd + k) % 4 - rd] = src_byte(rs, k);
+  return 0;
+}
+static int hd_numeric(size *out, size *ret, size *disp)
+{
+  size nb, rd, k;
+  unsigned v;
+  unsigned char *img = hv + HL_OUT / 8;
+  v = hv_cell(HL_NUM_V); nb = hv_cell(HL_NUM_NB); rd = hv_cell(HL_NUM_RD) & 3u;
+  if(nb > 8) return EINVAL;
+  *out = span_bits(rd, nb); *ret = 0; *disp = 8 * rd;
+  memset(img, 0, (size_t)((*out + 7) / 8));
+  for(k = 0; k < nb; ++k) img[8 * ((rd + k) / 4) + (rd + k) % 4 - rd] = hv_rev[k < 4 ? (v >> (8 * k)) & 255u : 0u];
+  return 0;
+}
+/* the definitions by the numbers the language gave them (host_layout.h): the end of the block of the call (the
+ * bits a call writes: HL_..._END, to see that a call wrote all of its block) and the code */
+static const struct { unsigned number; size end; host_def fn; } host_defs[] = {
+  { HL_CLASH_N, HL_CLASH_END, hd_clashes }, { HL_FILL_N, HL_FILL_END, hd_fill }, { HL_ENC_N, HL_ENC_END, hd_encode },
+  { HL_ADD_N, HL_BIN_END, hd_add }, { HL_SUB_N, HL_BIN_END, hd_sub }, { HL_AND_N, HL_BIN_END, hd_and },
+  { HL_OR_N, HL_BIN_END, hd_or }, { HL_XOR_N, HL_BIN_END, hd_xor }, { HL_EQ_N, HL_BIN_END, hd_eq },
+  { HL_LT_N, HL_BIN_END, hd_lt }, { HL_ULT_N, HL_BIN_END, hd_ult }, { HL_PUT_N, HL_MV_END, hd_put },
+  { HL_CMOVE_N, HL_MV_END, hd_cmove }, { HL_NUM_N, HL_NUM_END, hd_numeric } };
+#define HOST_NDEFS (sizeof host_defs / sizeof host_defs[0])
+#define HW_FITS(at, n) ((n) <= (size)space_nbits && (at) <= (size)space_nbits - (n))
+/* The intervals [lo, hi) written by the calls of the last tick: the image and the 32-bit return value
+ * (sys_host_results; the audit of the checked emulator sees them as the ranges of the tick). */
+static size (*host_res)[2] = NULL;
+static size host_nres = 0;
+static void host_note(size lo, size hi)
+{
+  if(host_res != NULL && host_nres < 2 * (size)proc_n) { host_res[host_nres][0] = lo; host_res[host_nres][1] = hi; ++host_nres; }
+}
+void sys_host_results_clear(void)
+{
+  host_nres = 0;
+}
+size sys_host_results(size (**spans)[2])
+{
+  *spans = host_res;
+  return host_nres;
+}
+/* A failed call of a definition or of the long copy is an error of the development (not of the run): the message and the stop. */
+static void call_failed(const char *what, size id, int rc)
+{
+  fflush(channel_out);
+  fprintf(stderr, "emulator: %s %lu failed: status %d (%s) at tick %llu\n", what, (unsigned long)id, rc, strerror(rc),
+          (unsigned long long)emu_ticks);
+  exit(EXIT_CALL);
+}
+static unsigned long host_calls[16], host_errors;
+static size host_maxin[16];
+/* The processor holds a number: run that definition (the arguments are in hv; the block of the call was written to
+ * the bits [pos, pos + len)). */
+static void host_run(size pos, size len)
+{
+  size out = 0, ret = 0, disp = 0, lo, hi, k;
+  unsigned num = hv_get32(HL_PROC);
