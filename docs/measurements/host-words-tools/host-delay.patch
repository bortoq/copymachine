 /*
+ * HOST (18.13, 18.15): definitions on the host over the own space of the emulator.
+ * The space of the definitions is the array hv (bits, the same order as the
+ * program space: numeric fields least significant bit first): the input at
+ * the bit 0 (the payload of the request, copied there by one bitcpy), the
+ * output image at HV_OUT. A definition reads its input at the places it is
+ * set to, makes the output image (out bits), a 32-bit return value and, if it
+ * needs, a displacement of the position of the image (disp bits, added to the
+ * position given by the request: the position inside a slot of 64 bits that
+ * the definition knows from the payload, not from the program). The copying of
+ * the results into the program space (to the positions given by the request)
+ * is done here, by the same bitcpy; the definitions never touch the program
+ * space and do not know where the data of the caller are.
+ * The format the definitions are set to: a cell of the program memory is 32
+ * bits (numeric) at the start of a slot of 64 bits, a byte of the memory is 8
+ * bits at 64 * (a / 4) + 8 * (a % 4) bits over the start of the memory.
+ */
+#define HV_IN_BITS  8192u
+#define HV_OUT_BITS (1u << 23)
+#define HV_OUT      HV_IN_BITS
+static unsigned char hv[(HV_IN_BITS + HV_OUT_BITS) / 8];
+static unsigned char hv_rev[256];   /* the byte with its bits reversed: the bytes of numeric fields */
+static void hv_init(void)
+{
+  unsigned b, k;
+  for(b = 0; b < 256; ++b)
+  {
+    unsigned r = 0;
+    for(k = 0; k < 8; ++k) r |= ((b >> k) & 1u) << (7 - k);
+    hv_rev[b] = (unsigned char)r;
+  }
+}
+/* the 32-bit numeric field at the bit at (a multiple of 8) of hv */
+static unsigned hv_get32(size at)
+{
+  const unsigned char *p = hv + at / 8;
+  return (unsigned)hv_rev[p[0]] | (unsigned)hv_rev[p[1]] << 8 | (unsigned)hv_rev[p[2]] << 16 | (unsigned)hv_rev[p[3]] << 24;
+}
+typedef int (*host_def)(size in, size *out, size *ret, size *disp);
+/* 0: clashes ( size, new row, layer record ): the payload: size at 0; the cells (numeric 32 bits, one in each 64
+ * bits) of the new row (dl dh sl sh) from 168; the cells of a record of a layer from 424: the cell, the next, the
+ * count n (cell 2), and from the cell 3 the rows (four cells each) of the layer. The return value is -1 or 0: some
+ * interval of the new row and some interval of one of the n rows are both non-empty, overlap and have their lower
+ * ends below size. */
+static int hd_clashes(size in, size *out, size *ret, size *disp)
+{
+  unsigned size_, a[4], n, i, j, k;
+  (void)disp;
+  if(in < 424 + 3 * 64 + 32) return EINVAL;
+  n = hv_get32(424 + 2 * 64);
+  if(n > 7 || in < 424 + 64 * (3 + 4 * (size)n)) return EINVAL;
+  size_ = hv_get32(0);
+  for(j = 0; j < 4; ++j) a[j] = hv_get32(168 + 64 * (size)j);
+  *out = 0; *ret = 0;
+  for(k = 0; k < n; ++k)
+  {
+    unsigned b[4];
+    for(i = 0; i < 4; ++i) b[i] = hv_get32(424 + 64 * (3 + 4 * (size)k + i));
+    for(j = 0; j < 2; ++j)
+      for(i = 0; i < 2; ++i)
+      {
+        unsigned l1 = a[2 * j], h1 = a[2 * j + 1], l2 = b[2 * i], h2 = b[2 * i + 1];
+        if(l1 < h1 && l2 < h2 && l1 < h2 && l2 < h1 && l1 < size_ && l2 < size_) { *ret = 0xffffffffu; return 0; }
+      }
+  }
+  return 0;
+}
+/* 1: fill ( u, c, alo ): the payload u at 0, c at 32, the two low bits r of the address at 64. The output image
+ * is the u bytes of the memory from the byte at the address, as they lie in the memory (a byte c, the 32 padding
+ * bits of each slot zero), the displacement 8 r (the position of the call is the start of the slot of the
+ * address); the return value is 0. */
+static int hd_fill(size in, size *out, size *ret, size *disp)
+{
+  size u, r, k;
+  unsigned char rc;
+  unsigned char *img = hv + HV_OUT / 8;
+  if(in < 96) return EINVAL;
+  u = hv_get32(0); rc = hv_rev[hv_get32(32) & 255u]; r = hv_get32(64) & 3u;
+  *out = 0; *ret = 0; *disp = 8 * r;
+  if(!u) return 0;
+  if(64 * ((r + u - 1) / 4) + 8 * ((r + u - 1) % 4) + 8 - 8 * r > HV_OUT_BITS) return EINVAL;
+  *out = 64 * ((r + u - 1) / 4) + 8 * ((r + u - 1) % 4) + 8 - 8 * r;
+  memset(img, 0, (size_t)((*out + 7) / 8));
+  k = 0;
+  while(k < u && (r + k) % 4) { img[8 * ((r + k) / 4) + (r + k) % 4 - r] = rc; ++k; }
+  for(; k + 4 <= u; k += 4)
+  {
+    unsigned char *p = img + 8 * ((r + k) / 4) - r;
+    p[0] = p[1] = p[2] = p[3] = rc;
+  }
+  for(; k < u; ++k) img[8 * ((r + k) / 4) + (r + k) % 4 - r] = rc;
+  return 0;
+}
+/* 2: encode ( a, slots, count, rows ): payload a at 0, slots at 32, count at 64, the cells of the rows (4 cells
+ * each) from 168. The output image: the layer of slots rows of four a-bit fields (numeric bytes), the rows after
+ * count zero, in the cells of memory (4 bytes in each 64 bits). The return value is 0, or -24 if a field does not
+ * fit in a bits (a < 32). */
+static int hd_encode(size in, size *out, size *ret, size *disp)
+{
+  size a, slots, count, nbytes, lbytes, j, i, b;
+  unsigned char *img = hv + HV_OUT / 8;
+  (void)disp;
+  if(in < 168 + 64 * 31 + 32) return EINVAL;
+  a = hv_get32(0); slots = hv_get32(32); count = hv_get32(64);
+  if(a % 8 || !a || a > 64 || !slots || slots > 8 || count > slots) return EINVAL;
+  nbytes = a / 8;
+  lbytes = slots * 4 * nbytes;
+  if(lbytes % 4 || 16 * lbytes > HV_OUT_BITS) return EINVAL;
+  memset(img, 0, (size_t)(16 * lbytes / 8));
+  *out = 16 * lbytes; *ret = 0;
+  for(j = 0; j < count; ++j)
+    for(i = 0; i < 4; ++i)
+    {
+      size v = hv_get32(168 + 64 * (4 * j + i));
+      if(a < 32 && (v >> a)) { *out = 0; *ret = 0xffffffe8u; return 0; }
+      if(a == 32) { memcpy(img + 8 * (4 * j + i), hv + (168 + 64 * (4 * j + i)) / 8, 4); continue; }  /* the same bytes: numeric both */
+      for(b = 0; b < nbytes; ++b)
+      {
+        size at = (4 * j + i) * nbytes + b;      /* the byte of the buffer */
+        img[(64 * (at / 4) + 8 * (at % 4)) / 8] = hv_rev[b < 4 ? (v >> (8 * b)) & 255u : 0];
+      }
+    }
+  return 0;
+}
+/* 3..10: the binary operations of the words + - and or xor = < u< ( a b -- r ): the payload a at 0, b at 32 (32 bits,
+ * numeric); no image; the return value is the result (the flags are -1 and 0, as in the words). */
+#define HD_BIN(name, expr) \
+  static int name(size in, size *out, size *ret, size *disp) \
+  { \
+    unsigned a, b; \
+    (void)disp; \
+    if(in < 64) return EINVAL; \
+    a = hv_get32(0); b = hv_get32(32); \
+    *out = 0; *ret = (unsigned)(expr); \
+    return 0; \
+  }
+HD_BIN(hd_add, a + b)
+HD_BIN(hd_sub, a - b)
+HD_BIN(hd_and, a & b)
+HD_BIN(hd_or, a | b)
+HD_BIN(hd_xor, a ^ b)
+HD_BIN(hd_eq, a == b ? 0xffffffffu : 0u)
+HD_BIN(hd_lt, (int)a < (int)b ? 0xffffffffu : 0u)
+HD_BIN(hd_ult, a < b ? 0xffffffffu : 0u)
+static const host_def host_defs[] = { hd_clashes, hd_fill, hd_encode, hd_add, hd_sub, hd_and, hd_or, hd_xor, hd_eq, hd_lt, hd_ult };
+#define HOST_NDEFS (sizeof host_defs / sizeof host_defs[0])
+#define HW_FITS(at, n) ((n) <= (size)space_nbits && (at) <= (size)space_nbits - (n))
+/* the request at bit address base (n bits written to SYS): returns the status */
+static int host_call1(size base, size n, const size *v);
+static unsigned long host_calls[16], host_errors;
+static int host_call(size base, size n, const size *v)
+{
+  int rc;
+  if(v[3] < 16) host_calls[v[3]]++;
+  rc = host_call1(base, n, v);
+  if(rc) { host_errors++; if(getenv("HOST_STATS")) fprintf(stderr, "emulator: HOST %lu failed: %d\n", (unsigned long)v[3], rc); }
+  return rc;
+}
+static int host_call1(size base, size n, const size *v)
+{
+  size in, out = 0, ret = 0, disp = 0, lo = v[4] & 0xffffffffu, hi = v[4] >> 32;
+  if(n < req_bits || v[3] >= HOST_NDEFS) return EINVAL;
+  in = n - req_bits;
+  if(in > HV_IN_BITS) return EINVAL;
+  bitcpy((size_t)in, space, (size_t)(base + req_bits), hv, 0);
+  if(host_defs[v[3]](in, &out, &ret, &disp)) return EINVAL;
+  lo += disp;
+  if(out && !HW_FITS(lo, out)) return EFAULT;
+  if(!HW_FITS(hi, 32)) return EFAULT;
+  if(out) bitcpy((size_t)out, hv, HV_OUT, space, (size_t)lo);
+  space_put(32, ret, hi);
+  return 0;
+}
+
