 /*
+ * HOST (18.13): definitions on the host over the own space of the emulator.
+ * The space of the definitions is the array hv (bits, the same order as the
+ * program space: numeric fields least significant bit first): the input at
+ * the bit 0 (the payload of the request, copied there by one bitcpy), the
+ * output image at HV_OUT. A definition reads its input at the places it is
+ * set to, makes the output image (out bits) and a 32-bit return value. The
+ * copying of the results into the program space (to the positions given by
+ * the request) is done here, by the same bitcpy; the definitions never touch
+ * the program space and do not know where the data of the caller are.
+ */
+#define HV_IN_BITS  8192u
+#define HV_OUT_BITS (1u << 23)
+#define HV_OUT      HV_IN_BITS
+static unsigned char hv[(HV_IN_BITS + HV_OUT_BITS) / 8];
+static size hv_get(size at, size n)
+{
+  unsigned char *keep = space;
+  size v;
+  space = hv; v = space_get(at, n); space = keep;
+  return v;
+}
+static void hv_put(size at, size n, size v)
+{
+  unsigned char *keep = space;
+  space = hv; space_put(n, v, at); space = keep;
+}
+typedef int (*host_def)(size in, size *out, size *ret);
+/* 0: row clash ( size, row1, row2 ): payload: size at 0; the cells (numeric 32 bits, one in each 64 bits) of the
+ * row1 (dl dh sl sh) from 168 and of the row2 from 424. The return value is -1 or 0: some interval of the
+ * row1 and some interval of the row2 are both non-empty, overlap and have their lower ends below size. */
+static int hd_row_clash(size in, size *out, size *ret)
+{
+  unsigned size_, a[4], b[4];
+  int j, i;
+  if(in < 424 + 3 * 64 + 32) return EINVAL;
+  size_ = (unsigned)hv_get(0, 32);
+  for(j = 0; j < 4; ++j) { a[j] = (unsigned)hv_get(168 + 64 * (size)j, 32); b[j] = (unsigned)hv_get(424 + 64 * (size)j, 32); }
+  *out = 0; *ret = 0;
+  for(j = 0; j < 2; ++j)
+    for(i = 0; i < 2; ++i)
+    {
+      unsigned l1 = a[2 * j], h1 = a[2 * j + 1], l2 = b[2 * i], h2 = b[2 * i + 1];
+      if(l1 < h1 && l2 < h2 && l1 < h2 && l2 < h1 && l1 < size_ && l2 < size_) *ret = 0xffffffffu;
+    }
+  return 0;
+}
+/* 1: fill ( u, c, alo ): payload u at 0, c at 32, the two low bits of the address at 64. If the address and u are
+ * cell aligned the output image is u/4 cells (32 bits numeric of the byte c four times, the other 32 bits of each
+ * 64 zero) and the return value 0; else no image and the return value 1. */
+static int hd_fill(size in, size *out, size *ret)
+{
+  size u, cells, k;
+  unsigned c;
+  if(in < 96) return EINVAL;
+  u = hv_get(0, 32); c = (unsigned)hv_get(32, 32) & 255u;
+  *out = 0; *ret = 1;
+  if(u % 4 || hv_get(64, 32)) return 0;
+  if(u / 4 > HV_OUT_BITS / 64) return EINVAL;
+  cells = u / 4;
+  *out = 64 * cells; *ret = 0;
+  if(!cells) return 0;
+  hv_put(HV_OUT, 32, (size)c * 16843009u); hv_put(HV_OUT + 32, 32, 0);
+  for(k = 1; k < cells; ++k) memcpy(hv + HV_OUT / 8 + 8 * k, hv + HV_OUT / 8, 8);
+  return 0;
+}
+/* 2: encode ( a, slots, count, rows ): payload a at 0, slots at 32, count at 64, the cells of the rows (4 cells
+ * each) from 168. The output image: the layer of slots rows of four a-bit fields (numeric bytes), the rows after
+ * count zero, in the cells of memory (4 bytes in each 64 bits). The return value is 0, or -24 if a field does not
+ * fit in a bits (a < 32). */
+static int hd_encode(size in, size *out, size *ret)
+{
+  size a, slots, count, nbytes, lbytes, j, i, b;
+  if(in < 168 + 64 * 31 + 32) return EINVAL;
+  a = hv_get(0, 32); slots = hv_get(32, 32); count = hv_get(64, 32);
+  if(a % 8 || !a || a > 64 || !slots || slots > 8 || count > slots) return EINVAL;
+  nbytes = a / 8;
+  lbytes = slots * 4 * nbytes;
+  if(lbytes % 4 || 16 * lbytes > HV_OUT_BITS) return EINVAL;
+  memset(hv + HV_OUT / 8, 0, (size_t)(16 * lbytes / 8));
+  *out = 16 * lbytes; *ret = 0;
+  for(j = 0; j < count; ++j)
+    for(i = 0; i < 4; ++i)
+    {
+      size v = hv_get(168 + 64 * (4 * j + i), 32);
+      if(a < 32 && (v >> a)) { *out = 0; *ret = 0xffffffe8u; return 0; }
+      for(b = 0; b < nbytes; ++b)
+      {
+        size at = (4 * j + i) * nbytes + b;      /* the byte of the buffer */
+        hv_put(HV_OUT + 64 * (at / 4) + 8 * (at % 4), 8, b < 4 ? (v >> (8 * b)) & 255u : 0);
+      }
+    }
+  return 0;
+}
+static const host_def host_defs[] = { hd_row_clash, hd_fill, hd_encode };
+#define HOST_NDEFS (sizeof host_defs / sizeof host_defs[0])
+#define HW_FITS(at, n) ((n) <= (size)space_nbits && (at) <= (size)space_nbits - (n))
+/* the request at bit address base (n bits written to SYS): returns the status */
+static int host_call1(size base, size n, const size *v);
+static unsigned long host_calls[8], host_errors;
+static int host_call(size base, size n, const size *v)
+{
+  int rc;
+  if(v[3] < 8) host_calls[v[3]]++;
+  rc = host_call1(base, n, v);
+  if(rc) { host_errors++; if(getenv("HOST_STATS")) fprintf(stderr, "emulator: HOST %lu failed: %d\n", (unsigned long)v[3], rc); }
+  return rc;
+}
+static int host_call1(size base, size n, const size *v)
+{
+  size in, out = 0, ret = 0, lo = v[4] & 0xffffffffu, hi = v[4] >> 32;
+  if(n < req_bits || v[3] >= HOST_NDEFS) return EINVAL;
+  in = n - req_bits;
+  if(in > HV_IN_BITS) return EINVAL;
+  bitcpy((size_t)in, space, (size_t)(base + req_bits), hv, 0);
+  if(host_defs[v[3]](in, &out, &ret)) return EINVAL;
+  if(out && !HW_FITS(lo, out)) return EFAULT;
+  if(!HW_FITS(hi, 32)) return EFAULT;
+  if(out) bitcpy((size_t)out, hv, HV_OUT, space, (size_t)lo);
+  space_put(32, ret, hi);
+  return 0;
+}
+
