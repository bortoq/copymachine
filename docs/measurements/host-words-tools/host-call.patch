diff -ruN '--exclude=build' '--exclude=__pycache__' '--exclude=proto_gen.h' '--exclude=core.md' '--exclude=docs' base/language/tools/boot_call.py w1813/language/tools/boot_call.py
--- base/language/tools/boot_call.py	1970-01-01 02:00:00.000000000 +0200
+++ w1813/language/tools/boot_call.py	2026-10-31 00:36:01.252484493 +0200
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""18.13 (experiment): boot of the variant of the language in which `fill`, `cc-row-clash?` and the encoding of a
+layer (`cc-encode`) are executed by the emulator through the call HOST (op 7, hostcall/*.fth, the generators
+%HFILL %HROW %HENC of primitives.fth). The host pForth loads the compiler natively with the ordinary
+definitions of all words; only the text that the compiler compiles into L0 (the kernel) has the definitions
+replaced. Usage: boot_call.py -o L0.call [--words fill,row,enc]"""
+import argparse
+import hashlib
+import subprocess
+import sys
+import time
+
+import boot
+import host
+import paths
+
+HC = paths.ROOT / 'hostcall'
+FILL = (': fill ( addr u c -- )\n  over 3 and 3 pick 3 and or 0= if\n'
+        '    255 and 16843009 * fill-cell ! 2 rshift 0 ?do fill-cell @ over i cells + ! loop drop exit\n'
+        '  then swap 0 ?do 2dup swap i + c! loop 2drop ;\n')
+ROWCLASH = (': cc-row-clash? ( row1 row2 -- flag )\n  cc-rb ! cc-ra ! 0\n  2 0 do 2 0 do\n'
+            '    cc-ra @ j 2* cells + 2@ swap cc-rb @ i 2* cells + 2@ swap cc-clash? or\n  loop loop ;\n')
+NEWROW = 'create cc-new-row 4 cells allot\n'
+ENCODE = (': cc-encode ( rows count -- )\n  cc-dest @ cc-lbytes 0 fill\n  0 ?do\n    4 0 do\n'
+          '      dup j 2 lshift i + cells + @ cc-field-check\n'
+          '      cc-a @ 32 = if cc-dest @ j 4 lshift + i 2 lshift + cc-numeric4\n'
+          '      else cc-a @ 3 rshift cc-dest @ j 2 lshift i + cc-a @ 3 rshift * + cc-numeric then\n'
+          '    loop\n  loop drop ;\n')
+ROWS = 'create cc-rows 32 cells allot\n'
+
+
+def kernel_text(words):
+    text = paths.text(paths.KERNEL_FILES)
+    if 'fill' in words:
+        assert FILL in text
+        text = text.replace(FILL, (HC / 'fill.fth').read_text())
+    if 'row' in words:
+        assert ROWCLASH in text and text.count(NEWROW) == 1
+        text = text.replace(NEWROW, '').replace(ROWCLASH, (HC / 'rowclash.fth').read_text())
+    if 'enc' in words:
+        assert ENCODE in text and text.count(ROWS) == 1
+        text = text.replace(ROWS, '').replace(ENCODE, (HC / 'encode.fth').read_text())
+    return text
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('-o', '--output', required=True)
+    parser.add_argument('--words', default='fill,row,enc')
+    parser.add_argument('--extra', help='a text inserted before the heap (measurements)')
+    args = parser.parse_args()
+    words = [w for w in args.words.split(',') if w]
+    text = kernel_text(words)
+    if args.extra:
+        mark = 'create kn-heap-start'
+        assert mark in text
+        text = text.replace(mark, open(args.extra).read() + mark)
+    lines = [boot.SIZES] + ['fc| ' + line for line in text.split('\n')] + ['fc-go', 'bye']
+    data = paths.source_bytes(paths.LIBRARY_FILES) + ('\n'.join(lines) + '\n').encode('latin-1')
+    executable = host.build()
+    start = time.monotonic()
+    result = subprocess.run([str(executable)], input=data, capture_output=True, timeout=3000, check=False)
+    seconds = time.monotonic() - start
+    if result.returncode or result.stderr or not result.stdout.endswith(b'\n'):
+        sys.exit(f'boot failed: code {result.returncode}, {result.stdout[-300:]!r}, {result.stderr[-300:]!r}')
+    stream = result.stdout[:-1]
+    open(args.output, 'wb').write(stream)
+    print(f'boot_call({args.words}): L0 {len(stream)} bytes in {seconds:.1f} s, sha256 {hashlib.sha256(stream).hexdigest()[:16]}')
+
+
+if __name__ == '__main__':
+    main()
