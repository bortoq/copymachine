--- a/language/tools/boot_call.py	1970-01-01 02:00:00.000000000 +0200
+++ b/language/tools/boot_call.py	2026-10-31 12:40:41.000000000 +0200
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""18.13, 18.15, 18.16 (experiment): boot of the variant of the language in which `fill`, `lay-clashes?` (the clash of the
+new row with the rows of a layer), the encoding of a layer (`lay-encode`), the sink of the kernel (`kn-put`: `put`), `cmove`,
+`lay-numeric` and `+!` are executed by the emulator through the call HOST (op 7, hostcall/*.fth, the generators of the same
+names in primitives.fth: the call is put in the place of use). The host pForth loads the compiler natively with the
+ordinary definitions of all words; only the text that the compiler compiles into L0 (the kernel) has the definitions
+replaced. Usage: boot_call.py -o L0.call [--words fill,row,enc,put,cmove,numeric,pstore]"""
+import argparse
+import hashlib
+import subprocess
+import sys
+import time
+
+import boot
+import host
+import paths
+
+HC = paths.ROOT / 'hostcall'
+FILL = (': fill ( addr u c -- )\n  over 3 and 3 pick 3 and or 0= if\n'
+        '    255 and 16843009 * fill-cell ! 2 rshift 0 ?do fill-cell @ over i cells + ! loop drop exit\n'
+        '  then swap 0 ?do 2dup swap i + c! loop 2drop ;\n')
+ROWCLASH = (': lay-row-clash? ( row1 row2 -- flag )\n  lay-rb ! lay-ra ! 0\n  2 0 do 2 0 do\n'
+            '    lay-ra @ j 2* cells + 2@ swap lay-rb @ i 2* cells + 2@ swap lay-clash? or\n  loop loop ;\n')
+NEWROW = 'create lay-new-row 4 cells allot\n'
+CLASHES = (': lay-clashes? ( -- flag )\n  0 lay-cur @ lay-count 0 ?do\n'
+           '    lay-new-row lay-cur @ i lay-row-addr lay-row-clash? if drop -1 leave then\n  loop ;\n')
+ENCODE = (': lay-encode ( rows count -- )\n  lay-dest @ lay-lbytes 0 fill\n  0 ?do\n    4 0 do\n'
+          '      dup j 2 lshift i + cells + @ lay-field-check\n'
+          '      lay-a @ 32 = if lay-dest @ j 4 lshift + i 2 lshift + lay-numeric4\n'
+          '      else lay-a @ 3 rshift lay-dest @ j 2 lshift i + lay-a @ 3 rshift * + lay-numeric then\n'
+          '    loop\n  loop drop ;\n')
+ROWS = 'create lay-rows 32 cells allot\n'
+CMOVE = (': cmove ( src dst u -- )\n  dup 3 and 2 pick 3 and or 3 pick 3 and or 0= if\n'
+         '    2 rshift 0 ?do over i cells + @ over i cells + ! loop 2drop exit\n'
+         '  then 0 ?do over i + c@ over i + c! loop 2drop ;\n')
+NUMERIC = (': lay-numeric ( value nbytes addr -- )\n  swap 0 ?do\n'
+           '    over i 4 < if i 3 lshift rshift 255 and lay-rev + c@ else drop 0 then\n'
+           '    over i + c!\n  loop 2drop ;\n')
+PSTORE = ': +! ( n addr -- ) dup >r @ + r> ! ;\n'
+PUT_TAIL = ('  rot kn-at !\n  over 3 and 0= if\n'
+            '    dup 2 rshift 0 ?do over i cells + @ kn-at @ dup 32 + space! 32 kn-at +! loop\n'
+            '    dup -4 and rot + swap 3 and\n  then\n'
+            '  0 ?do dup i + c@ kn-at @ dup 8 + spacec! 8 kn-at +! loop drop ;\n')
+PUT_HEAD = ': kn-put ( bit-address src n -- )\n'
+PUT_NEW = ('  begin dup 128 > while\n    2 pick 2 pick 128 %hput\n'
+           '    rot 1024 + rot 128 + rot 128 -\n  repeat %hput ;\n')
+
+
+def kernel_text(words):
+    text = paths.text(paths.KERNEL_FILES)
+    if words:
+        text = (HC / 'common.fth').read_text() + text
+    if 'fill' in words:
+        assert FILL in text
+        text = text.replace(FILL, (HC / 'fill.fth').read_text())
+    if 'row' in words:
+        assert ROWCLASH in text and CLASHES in text and text.count(NEWROW) == 1
+        text = text.replace(NEWROW, '').replace(CLASHES, '').replace(ROWCLASH, (HC / 'rowclash.fth').read_text())
+    if 'enc' in words:
+        assert ENCODE in text and text.count(ROWS) == 1
+        text = text.replace(ROWS, '').replace(ENCODE, (HC / 'encode.fth').read_text())
+    if 'cmove' in words:
+        assert CMOVE in text
+        text = text.replace(CMOVE, (HC / 'cmove.fth').read_text())
+    if 'numeric' in words:
+        assert NUMERIC in text
+        text = text.replace(NUMERIC, (HC / 'numeric.fth').read_text())
+    if 'pstore' in words:
+        assert PSTORE in text
+        text = text.replace(PSTORE, '')
+    if 'put' in words:
+        assert PUT_TAIL in text and PUT_HEAD in text
+        text = text.replace(PUT_TAIL, PUT_NEW).replace(PUT_HEAD, (HC / 'put.fth').read_text() + PUT_HEAD)
+    return text
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('-o', '--output', required=True)
+    parser.add_argument('--words', default='fill,row,enc,put,cmove,numeric,pstore')
+    parser.add_argument('--extra', help='a text inserted before the heap (measurements)')
+    args = parser.parse_args()
+    words = [w for w in args.words.split(',') if w]
+    text = kernel_text(words)
+    if args.extra:
+        mark = 'create kn-heap-start'
+        assert mark in text
+        text = text.replace(mark, open(args.extra).read() + mark)
+    lines = [boot.SIZES] + ['fc| ' + line for line in text.split('\n')] + ['fc-go', 'bye']
+    data = paths.source_bytes(paths.LIBRARY_FILES) + ('\n'.join(lines) + '\n').encode('latin-1')
+    executable = host.build()
+    start = time.monotonic()
+    result = subprocess.run([str(executable)], input=data, capture_output=True, timeout=3000, check=False)
+    seconds = time.monotonic() - start
+    if result.returncode or result.stderr or not result.stdout.endswith(b'\n'):
+        sys.exit(f'boot failed: code {result.returncode}, {result.stdout[-300:]!r}, {result.stderr[-300:]!r}')
+    stream = result.stdout[:-1]
+    open(args.output, 'wb').write(stream)
+    print(f'boot_call({args.words}): L0 {len(stream)} bytes in {seconds:.1f} s, sha256 {hashlib.sha256(stream).hexdigest()[:16]}')
+
+
+if __name__ == '__main__':
+    main()
