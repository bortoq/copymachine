diff -ruN '--exclude=build' '--exclude=__pycache__' '--exclude=proto_gen.h' '--exclude=core.md' base/emulator/src/sys_ctrl.c w1811/emulator/src/sys_ctrl.c
--- base/emulator/src/sys_ctrl.c	2026-10-30 21:44:55.000000000 +0200
+++ w1811/emulator/src/sys_ctrl.c	2026-10-30 21:50:54.822405717 +0200
@@ -317,6 +317,104 @@
