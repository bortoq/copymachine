 }
 
+
+/*
+ * HOST (18.11): definitions of words on the host with direct access to the
+ * memory of the space. The memory of the program ("Forth address" a) is the
+ * cell a>>2 at the bit origin + 64*(a>>2), 32 bits numeric, byte a&3 of it at
+ * +8*(a&3). Every bit read or written is checked to lie inside the space.
+ */
+static unsigned char rev8[256];
+static void rev8_init(void)
+{
+  unsigned i, k;
+  for(i = 0; i < 256; ++i)
+  {
+    unsigned r = 0;
+    for(k = 0; k < 8; ++k) r |= ((i >> k) & 1u) << (7 - k);
+    rev8[i] = (unsigned char)r;
+  }
+}
+static inline unsigned rd32(size at)      /* at is a multiple of 8 */
+{
+  const unsigned char *p = space + at / 8;
+  return (unsigned)rev8[p[0]] | (unsigned)rev8[p[1]] << 8 | (unsigned)rev8[p[2]] << 16 | (unsigned)rev8[p[3]] << 24;
+}
+static inline void wr32(size at, unsigned v)
+{
+  unsigned char *p = space + at / 8;
+  p[0] = rev8[v & 255]; p[1] = rev8[(v >> 8) & 255]; p[2] = rev8[(v >> 16) & 255]; p[3] = rev8[v >> 24];
+}
+#define HW_INSIDE(at, n) ((at) <= (size)space_nbits && (n) <= (size)space_nbits - (at))
+/* the bit address of the cell with the program address a (checked: 32 bits inside the space) */
+#define HW_CELL(org, a) ((org) + 16 * (size)((a) & ~3u))
+/* the cell i of the argument block at the program address blk */
+static int hw_arg(size org, size blk, unsigned i, unsigned *v)
+{
+  size at;
+  if(blk > 0x7fffffffu) return EFAULT;
+  at = HW_CELL(org, (unsigned)blk + 4 * i);
+  if(!HW_INSIDE(at, 32)) return EFAULT;
+  *v = rd32(at);
+  return 0;
+}
+static int hw_result(size org, size blk, unsigned v)
+{
+  size at = HW_CELL(org, (unsigned)blk);
+  if(!HW_INSIDE(at, 32)) return EFAULT;
+  wr32(at, v);
+  return 0;
+}
+/* word 0: cc-row-clash? ( row1 row2 size -- flag ): two rows of four cells (dl dh sl sh) clash if
+ * any of their two intervals each clash: both non-empty, overlapping, lower ends below size. */
+static int hw_row_clash(size org, size blk)
+{
+  unsigned a, b, size_, la[4], lb[4];
+  int j, i;
+  if(hw_arg(org, blk, 0, &a) || hw_arg(org, blk, 1, &b) || hw_arg(org, blk, 2, &size_)) return EFAULT;
+  if(a > 0x7fffffffu - 16 || b > 0x7fffffffu - 16) return EFAULT;
+  for(j = 0; j < 4; ++j)
+  {
+    size pa = HW_CELL(org, a + 4 * (unsigned)j), pb = HW_CELL(org, b + 4 * (unsigned)j);
+    if(!HW_INSIDE(pa, 32) || !HW_INSIDE(pb, 32)) return EFAULT;
+    la[j] = rd32(pa); lb[j] = rd32(pb);
+  }
+  for(j = 0; j < 2; ++j)
+    for(i = 0; i < 2; ++i)
+    {
+      unsigned l1 = la[2 * j], h1 = la[2 * j + 1], l2 = lb[2 * i], h2 = lb[2 * i + 1];
+      if(l1 < h1 && l2 < h2 && l1 < h2 && l2 < h1 && l1 < size_ && l2 < size_)
+        return hw_result(org, blk, 0xffffffffu);
+    }
+  return hw_result(org, blk, 0);
+}
+/* word 1: fill ( addr u c -- ): u bytes from the program address addr get the byte c. */
+static int hw_fill(size org, size blk)
+{
+  unsigned a, u, c, x;
+  unsigned char r;
+  size base;
+  if(hw_arg(org, blk, 0, &a) || hw_arg(org, blk, 1, &u) || hw_arg(org, blk, 2, &c)) return EFAULT;
+  if(!u) return 0;
+  if(a > 0x7fffffffu || u > 0x7fffffffu || (size)a + u > 0x80000000u) return EFAULT;
+  if(!HW_INSIDE(HW_CELL(org, a), 16 * (size)(u + 8))) return EFAULT;
+  r = rev8[c & 255u];
+  base = HW_CELL(org, a) / 8;
+  for(x = a & 3u; x < (a & 3u) + u; ++x)
+    space[base + 8 * (size)(x >> 2) + (x & 3u)] = r;
+  return 0;
+}
+static int host_word(size k, size org, size blk)
+{
+  if(org % 8) return EINVAL;
+  switch(k)
+  {
+    case 0: return hw_row_clash(org, blk);
+    case 1: return hw_fill(org, blk);
+    default: return EINVAL;
+  }
+}
