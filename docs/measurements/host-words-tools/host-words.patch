diff -ruN '--exclude=build' '--exclude=__pycache__' '--exclude=core.md' base/language/tools/boot_host.py w1811/language/tools/boot_host.py
--- base/language/tools/boot_host.py	1970-01-01 02:00:00.000000000 +0200
+++ w1811/language/tools/boot_host.py	2026-10-30 21:52:36.621262200 +0200
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""18.11 (experiment): boot of the variant of the language in which `fill` and `cc-row-clash?` are
+executed by the emulator (op HOST, hostwords/*.fth). The host pForth still loads the compiler natively
+with the ordinary definitions of all words (the library); only the text that the compiler compiles into
+L0 (the kernel) has the two definitions replaced. Usage: boot_host.py -o L0.host [--words fill,row]"""
+import argparse
+import hashlib
+import json
+import subprocess
+import sys
+import time
+
+import boot
+import host
+import paths
+
+HW = paths.ROOT / 'hostwords'
+FILL = (': fill ( addr u c -- )\n  over 3 and 3 pick 3 and or 0= if\n'
+        '    255 and 16843009 * fill-cell ! 2 rshift 0 ?do fill-cell @ over i cells + ! loop drop exit\n'
+        '  then swap 0 ?do 2dup swap i + c! loop 2drop ;\n')
+ROWCLASH = (': cc-row-clash? ( row1 row2 -- flag )\n  cc-rb ! cc-ra ! 0\n  2 0 do 2 0 do\n'
+            '    cc-ra @ j 2* cells + 2@ swap cc-rb @ i 2* cells + 2@ swap cc-clash? or\n  loop loop ;\n')
+
+
+def kernel_text(words):
+    text = paths.text(paths.KERNEL_FILES)
+    assert FILL in text and ROWCLASH in text
+    infra = (HW / 'infra.fth').read_text()
+    if 'fill' not in words:         # infra ends with the definition of fill: drop it
+        infra = infra[:infra.index(': fill')]
+    else:
+        text = text.replace(FILL, '')
+    if 'row' in words:
+        text = text.replace(ROWCLASH, (HW / 'rowclash.fth').read_text())
+    return infra + text
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('-o', '--output', required=True)
+    parser.add_argument('--words', default='fill,row')
+    args = parser.parse_args()
+    words = args.words.split(',')
+    lines = [boot.SIZES] + ['fc| ' + line for line in kernel_text(words).split('\n')] + ['fc-go', 'bye']
+    data = paths.source_bytes(paths.LIBRARY_FILES) + ('\n'.join(lines) + '\n').encode('latin-1')
+    executable = host.build()
+    start = time.monotonic()
+    result = subprocess.run([str(executable)], input=data, capture_output=True, timeout=3000, check=False)
+    seconds = time.monotonic() - start
+    if result.returncode or result.stderr or not result.stdout.endswith(b'\n'):
+        sys.exit(f'boot failed: code {result.returncode}, {result.stdout[-300:]!r}, {result.stderr[-300:]!r}')
+    stream = result.stdout[:-1]
+    open(args.output, 'wb').write(stream)
+    print(f'boot_host({args.words}): L0 {len(stream)} bytes in {seconds:.1f} s, sha256 {hashlib.sha256(stream).hexdigest()[:16]}')
+
+
+if __name__ == '__main__':
+    main()
